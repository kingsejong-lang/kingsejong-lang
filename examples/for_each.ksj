# 요소 반복: 컬렉션 각각에 대해 변수로 { }
# 배열은 요소, 문자열은 글자, 딕셔너리는 키(정렬 순)를 차례로 돈다.

이름들 = ["철수", "영희", "민수"]
이름들 각각에 대해 이름으로 {
    출력("안녕,", 이름)
}

# 문자열은 글자를 하나씩
글자수 = 0
"하늘과 바다" 각각에 대해 글자로 {
    만약 (글자 == " ") {
        계속
    }
    글자수 = 글자수 + 1
}
출력("공백을 뺀 글자 수:", 글자수)

# 딕셔너리는 키를 정렬한 순서로
점수 = {"수학": 90, "국어": 85, "영어": 70}
합계 = 0
점수 각각에 대해 과목으로 {
    출력(과목, 점수[과목])
    합계 = 합계 + 점수[과목]
}
출력("합계:", 합계)

# 처음으로 조건에 맞는 값을 찾으면 멈춘다
찾은값 = 없음
[3, 8, 12, 5] 각각에 대해 n으로 {
    만약 (n > 10) {
        찾은값 = n
        중단
    }
}
출력("10보다 큰 첫 값:", 찾은값)
