# 중단 / 계속: 반복문을 중간에 끝내거나 이번 회차를 건너뛴다

# 처음 찾은 위치에서 멈추는 검색
찾기 = 함수(목록, 값) {
    위치 = -1
    i가 0부터 길이(목록) 미만 {
        만약 (목록[i] == 값) {
            위치 = i
            중단
        }
    }
    반환 위치
}
출력("7 의 위치:", 찾기([5, 7, 9, 7], 7))
출력("4 의 위치:", 찾기([5, 7, 9, 7], 4))

# 홀수만 출력 (짝수는 건너뛴다)
i가 1부터 9까지 {
    만약 (i % 2 == 0) {
        계속
    }
    출력("홀수:", i)
}

# 조건 반복을 안에서 끝내기
합 = 0
n = 0
반복 (참) {
    n = n + 1
    만약 (합 + n > 20) {
        중단
    }
    합 = 합 + n
}
출력("20 을 넘기 전까지의 합:", 합, "마지막으로 더한 수:", n - 1)

# 시도 블록 안에서 빠져나가도 마지막 블록은 돈다
i가 1부터 3까지 {
    시도 {
        만약 (i == 2) {
            계속
        }
        출력("작업", i)
    } 마지막 {
        출력("정리", i)
    }
}

# 중첩 반복에서는 가장 안쪽 반복만 끝난다
행가 1부터 3까지 {
    줄 = []
    열가 1부터 5까지 {
        만약 (열 > 행) {
            중단
        }
        줄 = 줄 + [열]
    }
    출력(줄)
}
