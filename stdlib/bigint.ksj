# bigint 모듈
# KingSejong 표준 라이브러리 - 크기 제한이 없는 정수 (GMP 의 mpz, Python 의 int)
# 큰 정수는 {"부호": -1|0|1, "자리": [...]} 딕셔너리다. 자리는 10^9 진법이고 낮은 자리가 앞이며,
# 맨 뒤(가장 높은 자리)는 0 이 아니다. 0 은 부호 0, 빈 자리다. 함수는 인자를 바꾸지 않고 새 값을 돌려준다.
# 나눗셈은 언어의 / 와 % 처럼 0 쪽으로 버리고, 나머지의 부호는 나뉘는 수를 따른다.
# 모두 KingSejong 코드로 쓰였다.

큰자리_밑 = 1000000000

# --- 자리 배열(부호 없는 크기) 연산 ---

# 뒤쪽(높은 자리)의 0 을 떼어 낸다
큰자리_정리 = 함수(자리) {
    n = 길이(자리)
    반복 (n > 0 && 자리[n - 1] == 0) {
        n = n - 1
    }
    만약 (n == 길이(자리)) {
        반환 자리
    }
    반환 자리[0부터 n미만]
}

큰자리_비교 = 함수(a, b) {
    만약 (길이(a) != 길이(b)) {
        만약 (길이(a) < 길이(b)) {
            반환 -1
        }
        반환 1
    }
    i = 길이(a) - 1
    반복 (i >= 0) {
        만약 (a[i] != b[i]) {
            만약 (a[i] < b[i]) {
                반환 -1
            }
            반환 1
        }
        i = i - 1
    }
    반환 0
}

큰자리_더하기 = 함수(a, b) {
    결과 = []
    올림 = 0
    n = 길이(a)
    만약 (길이(b) > n) {
        n = 길이(b)
    }
    i = 0
    반복 (i < n) {
        합 = 올림
        만약 (i < 길이(a)) {
            합 = 합 + a[i]
        }
        만약 (i < 길이(b)) {
            합 = 합 + b[i]
        }
        만약 (합 >= 큰자리_밑) {
            결과에 덧붙인다(합 - 큰자리_밑)
            올림 = 1
        } 아니면 {
            결과에 덧붙인다(합)
            올림 = 0
        }
        i = i + 1
    }
    만약 (올림 > 0) {
        결과에 덧붙인다(올림)
    }
    반환 결과
}

# a >= b 일 때 a - b
큰자리_빼기 = 함수(a, b) {
    결과 = []
    빌림 = 0
    i = 0
    반복 (i < 길이(a)) {
        차 = a[i] - 빌림
        만약 (i < 길이(b)) {
            차 = 차 - b[i]
        }
        만약 (차 < 0) {
            결과에 덧붙인다(차 + 큰자리_밑)
            빌림 = 1
        } 아니면 {
            결과에 덧붙인다(차)
            빌림 = 0
        }
        i = i + 1
    }
    반환 큰자리_정리(결과)
}

# 자리 하나(0 이상 10^9 미만)를 곱한다. 한 자리 곱 + 올림은 10^18 을 넘지 않는다
큰자리_작은수_곱하기 = 함수(a, k) {
    만약 (k == 0) {
        반환 []
    }
    결과 = []
    올림 = 0
    a 각각에 대해 자리로 {
        곱 = 자리 * k + 올림
        결과에 덧붙인다(곱 % 큰자리_밑)
        올림 = 곱 / 큰자리_밑
    }
    만약 (올림 > 0) {
        결과에 덧붙인다(올림)
    }
    반환 결과
}

큰자리_곱하기 = 함수(a, b) {
    만약 (길이(a) == 0 || 길이(b) == 0) {
        반환 []
    }
    결과 = []
    i가 1부터 길이(a) + 길이(b)까지 {
        결과에 덧붙인다(0)
    }
    i = 0
    반복 (i < 길이(a)) {
        올림 = 0
        j = 0
        반복 (j < 길이(b)) {
            현재 = 결과[i + j] + a[i] * b[j] + 올림
            결과[i + j] = 현재 % 큰자리_밑
            올림 = 현재 / 큰자리_밑
            j = j + 1
        }
        결과[i + 길이(b)] = 결과[i + 길이(b)] + 올림
        i = i + 1
    }
    반환 큰자리_정리(결과)
}

# [몫, 나머지]. 나누는 수는 0 이 아니다.
# 높은 자리부터 나머지에 한 자리씩 내려 붙이고, 몫 한 자리를 두 윗자리로 어림한 범위에서 이진 탐색한다
큰자리_나누기 = 함수(a, b) {
    몫 = []
    i가 1부터 길이(a)까지 {
        몫에 덧붙인다(0)
    }
    나머지 = []
    bn = 길이(b)
    b위 = b[bn - 1]
    i = 길이(a) - 1
    반복 (i >= 0) {
        나머지 = 큰자리_정리([a[i]] + 나머지)
        만약 (큰자리_비교(나머지, b) >= 0) {
            rn = 길이(나머지)
            위 = 나머지[rn - 1]
            만약 (rn > bn) {
                위 = 위 * 큰자리_밑 + 나머지[rn - 2]
            }
            낮음 = 위 / (b위 + 1)
            높음 = (위 + 1) / b위
            만약 (높음 >= 큰자리_밑) {
                높음 = 큰자리_밑 - 1
            }
            # b * 낮음 <= 나머지 < b * (높음 + 1) 인 가장 큰 낮음을 찾는다
            반복 (낮음 < 높음) {
                중간 = (낮음 + 높음 + 1) / 2
                만약 (큰자리_비교(큰자리_작은수_곱하기(b, 중간), 나머지) <= 0) {
                    낮음 = 중간
                } 아니면 {
                    높음 = 중간 - 1
                }
            }
            나머지 = 큰자리_빼기(나머지, 큰자리_작은수_곱하기(b, 낮음))
            몫[i] = 낮음
        }
        i = i - 1
    }
    반환 [큰자리_정리(몫), 나머지]
}

# --- 큰 정수 ---

큰정수_만들기 = 함수(부호, 자리) {
    정리된 = 큰자리_정리(자리)
    만약 (길이(정리된) == 0) {
        반환 {"부호": 0, "자리": []}
    }
    반환 {"부호": 부호, "자리": 정리된}
}

# 정수 또는 10 진수 문자열("-123", "+45")로 큰 정수를 만든다. 큰 정수를 주면 그대로 돌려준다
큰정수 = 함수(값) {
    만약 (타입(값) == "딕셔너리") {
        반환 값
    }
    만약 (타입(값) == "문자열") {
        반환 큰정수_문자열_읽기(값)
    }
    만약 (타입(값) != "정수") {
        던지다 "큰정수: 정수나 문자열이어야 함: " + 문자열(값)
    }
    부호 = 1
    만약 (값 < 0) {
        부호 = -1
    }
    # 음수는 음수인 채로 나눈다: -9223372036854775808 의 부호를 바꾸면 넘친다
    자리 = []
    n = 값
    반복 (n != 0) {
        나머지 = n % 큰자리_밑
        만약 (나머지 < 0) {
            나머지 = -나머지
        }
        자리에 덧붙인다(나머지)
        n = n / 큰자리_밑
    }
    반환 큰정수_만들기(부호, 자리)
}

큰정수_문자열_읽기 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    n = 길이(글자들)
    시작 = 0
    부호 = 1
    만약 (n > 0 && (글자들[0] == "+" || 글자들[0] == "-")) {
        만약 (글자들[0] == "-") {
            부호 = -1
        }
        시작 = 1
    }
    만약 (시작 >= n) {
        던지다 "큰정수: 10 진수가 아님: " + 텍스트
    }
    # 뒤에서부터 9 글자씩 한 자리가 된다
    자리 = []
    끝 = n
    반복 (끝 > 시작) {
        처음 = 끝 - 9
        만약 (처음 < 시작) {
            처음 = 시작
        }
        값 = 0
        j = 처음
        반복 (j < 끝) {
            코드 = 문자코드(글자들[j])
            만약 (코드 < 48 || 코드 > 57) {
                던지다 "큰정수: 10 진수가 아님: " + 텍스트
            }
            값 = 값 * 10 + (코드 - 48)
            j = j + 1
        }
        자리에 덧붙인다(값)
        끝 = 처음
    }
    반환 큰정수_만들기(부호, 자리)
}

큰정수_문자열 = 함수(a) {
    x = 큰정수(a)
    자리 = x["자리"]
    n = 길이(자리)
    만약 (n == 0) {
        반환 "0"
    }
    조각들 = []
    만약 (x["부호"] < 0) {
        조각들에 덧붙인다("-")
    }
    조각들에 덧붙인다(문자열(자리[n - 1]))
    i = n - 2
    반복 (i >= 0) {
        조각 = 문자열(자리[i])
        반복 (길이(조각) < 9) {
            조각 = "0" + 조각
        }
        조각들에 덧붙인다(조각)
        i = i - 1
    }
    결과 = ""
    조각들 각각에 대해 조각으로 {
        결과 = 결과 + 조각
    }
    반환 결과
}

# 64 비트 정수로 돌려준다. 범위를 넘으면 오류
큰정수_정수 = 함수(a) {
    x = 큰정수(a)
    만약 (큰자리_비교(x["자리"], [854775807, 223372036]) > 0) {
        만약 (x["부호"] < 0 && 큰자리_비교(x["자리"], [854775808, 223372036, 9]) == 0) {
            반환 -9223372036854775807 - 1
        }
        만약 (큰자리_비교(x["자리"], [854775807, 223372036, 9]) > 0) {
            던지다 "큰정수_정수: 64 비트 정수 범위를 넘음: " + 큰정수_문자열(x)
        }
    }
    결과 = 0
    i = 길이(x["자리"]) - 1
    반복 (i >= 0) {
        결과 = 결과 * 큰자리_밑 + x["자리"][i]
        i = i - 1
    }
    반환 결과 * x["부호"]
}

큰정수_비교 = 함수(a, b) {
    x = 큰정수(a)
    y = 큰정수(b)
    만약 (x["부호"] != y["부호"]) {
        만약 (x["부호"] < y["부호"]) {
            반환 -1
        }
        반환 1
    }
    반환 큰자리_비교(x["자리"], y["자리"]) * x["부호"]
}

큰정수_음수 = 함수(a) {
    x = 큰정수(a)
    반환 {"부호": -x["부호"], "자리": x["자리"]}
}

큰정수_절댓값 = 함수(a) {
    x = 큰정수(a)
    만약 (x["부호"] < 0) {
        반환 큰정수_음수(x)
    }
    반환 x
}

큰정수_더하기 = 함수(a, b) {
    x = 큰정수(a)
    y = 큰정수(b)
    만약 (x["부호"] == 0) {
        반환 y
    }
    만약 (y["부호"] == 0) {
        반환 x
    }
    만약 (x["부호"] == y["부호"]) {
        반환 큰정수_만들기(x["부호"], 큰자리_더하기(x["자리"], y["자리"]))
    }
    # 부호가 다르면 큰 쪽 크기에서 작은 쪽 크기를 빼고 큰 쪽 부호를 붙인다
    비교 = 큰자리_비교(x["자리"], y["자리"])
    만약 (비교 == 0) {
        반환 큰정수(0)
    }
    만약 (비교 > 0) {
        반환 큰정수_만들기(x["부호"], 큰자리_빼기(x["자리"], y["자리"]))
    }
    반환 큰정수_만들기(y["부호"], 큰자리_빼기(y["자리"], x["자리"]))
}

큰정수_빼기 = 함수(a, b) {
    반환 큰정수_더하기(a, 큰정수_음수(b))
}

큰정수_곱하기 = 함수(a, b) {
    x = 큰정수(a)
    y = 큰정수(b)
    반환 큰정수_만들기(x["부호"] * y["부호"], 큰자리_곱하기(x["자리"], y["자리"]))
}

# [몫, 나머지]: 몫은 0 쪽으로 버리고 나머지 부호는 a 를 따른다 (언어의 / 와 % 와 같다)
큰정수_나누고_나머지 = 함수(a, b) {
    x = 큰정수(a)
    y = 큰정수(b)
    만약 (y["부호"] == 0) {
        던지다 "큰정수: 0 으로 나눌 수 없음"
    }
    결과 = 큰자리_나누기(x["자리"], y["자리"])
    반환 [큰정수_만들기(x["부호"] * y["부호"], 결과[0]), 큰정수_만들기(x["부호"], 결과[1])]
}

큰정수_나누기 = 함수(a, b) {
    반환 큰정수_나누고_나머지(a, b)[0]
}

큰정수_나머지 = 함수(a, b) {
    반환 큰정수_나누고_나머지(a, b)[1]
}

# 밑^지수 (지수는 0 이상의 정수). 제곱을 거듭해 곱셈 횟수를 log(지수) 로 줄인다
큰정수_거듭제곱 = 함수(밑, 지수) {
    만약 (지수 < 0) {
        던지다 "큰정수_거듭제곱: 지수는 0 이상이어야 함"
    }
    결과 = 큰정수(1)
    제곱 = 큰정수(밑)
    e = 지수
    반복 (e > 0) {
        만약 (e % 2 == 1) {
            결과 = 큰정수_곱하기(결과, 제곱)
        }
        e = e / 2
        만약 (e > 0) {
            제곱 = 큰정수_곱하기(제곱, 제곱)
        }
    }
    반환 결과
}

# 2 진수 자릿수 (0 은 0). 10 진 자릿수로 어림하고 2 의 거듭제곱과 비교해 맞춘다
큰정수_비트수 = 함수(a) {
    x = 큰정수_절댓값(a)
    만약 (x["부호"] == 0) {
        반환 0
    }
    자리 = x["자리"]
    위 = 자리[길이(자리) - 1]
    비트 = 0
    반복 (위 > 0) {
        비트 = 비트 + 1
        위 = 위 / 2
    }
    # 위 자리 아래로 (길이 - 1) 개의 10^9 자리가 있다: 10^9 는 2^29.897 이다
    어림 = 비트 + ((길이(자리) - 1) * 29897) / 1000
    만약 (어림 < 1) {
        어림 = 1
    }
    # 2^(어림 - 1) <= x < 2^어림 이 될 때까지 맞춘다
    반복 (큰정수_비교(x, 큰정수_거듭제곱(2, 어림 - 1)) < 0) {
        어림 = 어림 - 1
    }
    반복 (큰정수_비교(x, 큰정수_거듭제곱(2, 어림)) >= 0) {
        어림 = 어림 + 1
    }
    반환 어림
}

# 2^k (실수, -1074 <= k <= 1023). 2 의 거듭제곱은 이 범위에서 모두 정확하다
큰정수_이의_거듭제곱_실수 = 함수(k) {
    결과 = 1.0
    인수 = 2.0
    만약 (k < 0) {
        인수 = 0.5
    }
    i = k
    만약 (i < 0) {
        i = -i
    }
    반복 (i > 0) {
        결과 = 결과 * 인수
        i = i - 1
    }
    반환 결과
}

# 분자 / 분모(둘 다 양의 큰 정수)에 가장 가까운 실수 (짝수 쪽 반올림, IEEE 754 기본 반올림).
# 몫이 정확히 53 비트가 되도록 2^s 를 곱해 나누고, 나머지로 반올림한 뒤 2^-s 를 곱한다.
# 값이 비정규 범위면 s 를 1074 로 묶어 비트 수를 줄인다. 2^1024 이상이면 무한대
큰정수_분수_실수 = 함수(분자, 분모) {
    s = 53 - (큰정수_비트수(분자) - 큰정수_비트수(분모))
    # 반복문 본문에서 처음 만든 변수는 반복이 끝나면 없어지므로 미리 만든다
    결과 = []
    나눈수 = 분모
    몫 = 0
    반복 (참) {
        만약 (s > 1074) {
            s = 1074
        }
        만약 (s >= 0) {
            결과 = 큰정수_나누고_나머지(큰정수_곱하기(분자, 큰정수_거듭제곱(2, s)), 분모)
            나눈수 = 분모
        } 아니면 {
            나눈수 = 큰정수_곱하기(분모, 큰정수_거듭제곱(2, -s))
            결과 = 큰정수_나누고_나머지(분자, 나눈수)
        }
        몫 = 큰정수_정수(결과[0])
        만약 (몫 >= 9007199254740992) {
            s = s - 1
        } 아니면 만약 (몫 < 4503599627370496 && s < 1074) {
            s = s + 1
        } 아니면 {
            중단
        }
    }
    # 나머지의 두 배를 나눈 수와 견준다: 크면 올리고, 같으면 몫이 홀수일 때만 올린다
    반 = 큰정수_비교(큰정수_곱하기(결과[1], 2), 나눈수)
    만약 (반 > 0 || (반 == 0 && 몫 % 2 == 1)) {
        몫 = 몫 + 1
        만약 (몫 == 9007199254740992) {
            몫 = 4503599627370496
            s = s - 1
        }
    }
    만약 (53 - s > 1024) {
        반환 1e308 * 10.0
    }
    만약 (s < -971) {
        # 2^-s 자체가 실수 범위 밖이므로 두 번에 나눠 곱한다 (몫 < 2^53 이라 첫 곱은 넘치지 않는다)
        반환 실수(몫) * 큰정수_이의_거듭제곱_실수(-s - 53) * 큰정수_이의_거듭제곱_실수(53)
    }
    반환 실수(몫) * 큰정수_이의_거듭제곱_실수(-s)
}

# 큰 정수에 가장 가까운 실수
큰정수_실수 = 함수(a) {
    x = 큰정수(a)
    만약 (x["부호"] == 0) {
        반환 0.0
    }
    값 = 큰정수_분수_실수(큰정수_절댓값(x), 큰정수(1))
    만약 (x["부호"] < 0) {
        반환 -값
    }
    반환 값
}

# 10 진 자릿수 문자열 × 10^지수 에 가장 가까운 실수 (정확히 반올림되는 strtod 의 핵심)
십진_실수 = 함수(자릿수, 지수) {
    가수 = 큰정수(자릿수)
    만약 (가수["부호"] == 0) {
        반환 0.0
    }
    만약 (지수 >= 0) {
        반환 큰정수_분수_실수(큰정수_곱하기(가수, 큰정수_거듭제곱(10, 지수)), 큰정수(1))
    }
    반환 큰정수_분수_실수(가수, 큰정수_거듭제곱(10, -지수))
}
