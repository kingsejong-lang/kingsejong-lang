# bytes 모듈
# KingSejong 표준 라이브러리 - 바이트 배열 (0~255 정수 배열) 다루기
# 파일_바이트_읽기 / 파일_바이트_쓰기 와 함께 쓴다. 모두 KingSejong 코드로 쓰였다.
# 결과 배열은 덧붙인다 로 제자리에서 늘리고, 결과 문자열은 조각을 모아 조각_잇기 로 한 번에 만든다.
# (배열 = 배열 + [x], 문자열 = 문자열 + x 를 반복하면 매번 전체를 복사해서 O(n²) 이다)

# 문자열 배열을 하나로 잇는다. 둘씩 짝지어 합치므로 전체 길이 n 에 O(n log n)
조각_잇기 = 함수(조각들) {
    만약 (길이(조각들) == 0) {
        반환 ""
    }
    현재 = 조각들
    반복 (길이(현재) > 1) {
        합친것 = []
        i = 0
        반복 (i + 1 < 길이(현재)) {
            합친것에 덧붙인다(현재[i] + 현재[i + 1])
            i = i + 2
        }
        만약 (i < 길이(현재)) {
            합친것에 덧붙인다(현재[i])
        }
        현재 = 합친것
    }
    반환 현재[0]
}

# 문자열을 UTF-8 바이트 배열로
UTF8_인코딩 = 함수(텍스트) {
    결과 = []
    텍스트 각각에 대해 글자로 {
        c = 문자코드(글자)
        만약 (c < 0x80) {
            결과에 덧붙인다(c)
        } 아니면 만약 (c < 0x800) {
            결과에 덧붙인다(0xC0 | (c >> 6), 0x80 | (c & 0x3F))
        } 아니면 만약 (c < 0x10000) {
            결과에 덧붙인다(0xE0 | (c >> 12), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F))
        } 아니면 {
            결과에 덧붙인다(0xF0 | (c >> 18), 0x80 | ((c >> 12) & 0x3F), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F))
        }
    }
    반환 결과
}

# UTF-8 바이트 배열을 문자열로. 잘못된 순서(잘린 글자, 과잉 길이, 서로게이트)는 오류
UTF8_디코딩 = 함수(바이트들) {
    글자들 = []
    n = 길이(바이트들)
    i = 0
    반복 (i < n) {
        b = 바이트들[i]
        만약 (b < 0x80) {
            글자들에 덧붙인다(코드문자(b))
            i = i + 1
            계속
        }
        만약 (b >= 0xF0 && b <= 0xF4) {
            개수 = 3
            c = b & 0x07
            최소 = 0x10000
        } 아니면 만약 (b >= 0xE0) {
            만약 (b > 0xEF) {
                던지다 "UTF-8 이 아닌 바이트: " + 문자열(b)
            }
            개수 = 2
            c = b & 0x0F
            최소 = 0x800
        } 아니면 만약 (b >= 0xC2) {
            개수 = 1
            c = b & 0x1F
            최소 = 0x80
        } 아니면 {
            던지다 "UTF-8 이 아닌 바이트: " + 문자열(b)
        }
        만약 (i + 개수 >= n) {
            던지다 "UTF-8 글자가 중간에 끊김"
        }
        j가 1부터 개수까지 {
            다음 = 바이트들[i + j]
            만약 ((다음 & 0xC0) != 0x80) {
                던지다 "UTF-8 이어지는 바이트가 아님: " + 문자열(다음)
            }
            c = (c << 6) | (다음 & 0x3F)
        }
        만약 (c < 최소) {
            던지다 "UTF-8 과잉 길이 표현"
        }
        글자들에 덧붙인다(코드문자(c))
        i = i + 개수 + 1
    }
    반환 조각_잇기(글자들)
}

# 바이트 배열을 16진수 문자열로 ([255, 1] → "ff01")
십육진수_인코딩 = 함수(바이트들) {
    숫자들 = 분리("0123456789abcdef", "")
    조각들 = []
    바이트들 각각에 대해 b로 {
        조각들에 덧붙인다(숫자들[b >> 4] + 숫자들[b & 15])
    }
    반환 조각_잇기(조각들)
}

# 16진수 문자열을 바이트 배열로. 길이가 홀수이거나 16진수가 아닌 글자가 있으면 오류
십육진수_디코딩 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    만약 (길이(글자들) % 2 != 0) {
        던지다 "16진수 문자열의 길이가 홀수"
    }
    결과 = []
    i = 0
    반복 (i < 길이(글자들)) {
        결과에 덧붙인다((십육진수_자릿값(글자들[i]) << 4) | 십육진수_자릿값(글자들[i + 1]))
        i = i + 2
    }
    반환 결과
}

십육진수_자릿값 = 함수(글자) {
    c = 문자코드(글자)
    만약 (c >= 48 && c <= 57) {
        반환 c - 48
    }
    c = c | 32
    만약 (c >= 97 && c <= 102) {
        반환 c - 87
    }
    던지다 "16진수가 아닌 글자: " + 글자
}

BASE64_글자표 = 분리("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", "")

# 바이트 배열을 Base64 문자열로 (RFC 4648, '=' 채움)
BASE64_인코딩 = 함수(바이트들) {
    표 = BASE64_글자표
    조각들 = []
    n = 길이(바이트들)
    i = 0
    반복 (i + 2 < n) {
        v = (바이트들[i] << 16) | (바이트들[i + 1] << 8) | 바이트들[i + 2]
        조각들에 덧붙인다(표[v >> 18] + 표[(v >> 12) & 63] + 표[(v >> 6) & 63] + 표[v & 63])
        i = i + 3
    }
    남은 = n - i
    만약 (남은 == 1) {
        v = 바이트들[i] << 16
        조각들에 덧붙인다(표[v >> 18] + 표[(v >> 12) & 63] + "==")
    } 아니면 만약 (남은 == 2) {
        v = (바이트들[i] << 16) | (바이트들[i + 1] << 8)
        조각들에 덧붙인다(표[v >> 18] + 표[(v >> 12) & 63] + 표[(v >> 6) & 63] + "=")
    }
    반환 조각_잇기(조각들)
}

# Base64 문자열을 바이트 배열로. 길이가 4의 배수가 아니거나 Base64 가 아닌 글자가 있으면 오류
BASE64_디코딩 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    만약 (길이(글자들) % 4 != 0) {
        던지다 "Base64 문자열의 길이가 4의 배수가 아님"
    }
    값 = {}
    i가 0부터 64 미만 {
        값[BASE64_글자표[i]] = i
    }
    결과 = []
    i = 0
    반복 (i < 길이(글자들)) {
        채움 = 0
        v = 0
        j가 0부터 4 미만 {
            g = 글자들[i + j]
            만약 (g == "=" && i + 4 == 길이(글자들) && j >= 2) {
                채움 = 채움 + 1
                v = v << 6
            } 아니면 {
                만약 (채움 > 0 || !딕셔너리_포함(값, g)) {
                    던지다 "Base64 가 아닌 글자: " + g
                }
                v = (v << 6) | 값[g]
            }
        }
        결과에 덧붙인다(v >> 16)
        만약 (채움 < 2) {
            결과에 덧붙인다((v >> 8) & 255)
        }
        만약 (채움 < 1) {
            결과에 덧붙인다(v & 255)
        }
        i = i + 4
    }
    반환 결과
}

# FNV-1a 64비트 해시. 64비트를 넘는 곱은 감싸곱하기로 버린다
FNV1a_64 = 함수(바이트들) {
    h = 0xcbf29ce484222325
    바이트들 각각에 대해 b로 {
        h = 감싸곱하기(h ^ b, 0x100000001b3)
    }
    반환 h
}
