# char 모듈
# KingSejong 표준 라이브러리 - 문자 분류와 변환 (C 의 ctype.h)
# 모든 함수는 글자 하나(길이 1 인 문자열)를 받는다. ASCII 밖의 글자는 한글 판별 외에는 거짓이다.

숫자_글자인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 48 && c <= 57
}

대문자_글자인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 65 && c <= 90
}

소문자_글자인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 97 && c <= 122
}

영문_글자인가 = 함수(글자) {
    반환 대문자_글자인가(글자) || 소문자_글자인가(글자)
}

영숫자_글자인가 = 함수(글자) {
    반환 영문_글자인가(글자) || 숫자_글자인가(글자)
}

# 공백, 탭, 줄바꿈, 세로 탭, 폼 피드, 캐리지 리턴
공백_글자인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c == 32 || (c >= 9 && c <= 13)
}

십육진수_글자인가 = 함수(글자) {
    c = 문자코드(글자) | 32
    반환 숫자_글자인가(글자) || (c >= 97 && c <= 102)
}

# 완성형 한글 음절 (가 ~ 힣)
한글_글자인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 0xAC00 && c <= 0xD7A3
}

# 영문 소문자는 대문자로, 나머지 글자는 그대로
대문자로 = 함수(글자) {
    만약 (소문자_글자인가(글자)) {
        반환 코드문자(문자코드(글자) - 32)
    }
    반환 글자
}

소문자로 = 함수(글자) {
    만약 (대문자_글자인가(글자)) {
        반환 코드문자(문자코드(글자) + 32)
    }
    반환 글자
}

# 0-9, a-z, A-Z 를 자릿값으로. 자릿값이 아니면 -1
자릿값 = 함수(글자) {
    c = 문자코드(글자)
    만약 (c >= 48 && c <= 57) {
        반환 c - 48
    }
    c = c | 32
    만약 (c >= 97 && c <= 122) {
        반환 c - 87
    }
    반환 -1
}

# 한글 음절을 [초성, 중성, 종성] 인덱스로 나눈다. 종성이 없으면 0
한글_분해 = 함수(글자) {
    만약 (!한글_글자인가(글자)) {
        반환 없음
    }
    s = 문자코드(글자) - 0xAC00
    반환 [s / 588, (s % 588) / 28, s % 28]
}

# 받침(종성)이 있는가. 조사 고르기에 쓴다
받침있는가 = 함수(글자) {
    만약 (!한글_글자인가(글자)) {
        반환 거짓
    }
    반환 (문자코드(글자) - 0xAC00) % 28 != 0
}
