# convert 모듈
# KingSejong 표준 라이브러리 - 수와 문자열 변환 (C 의 strtol, strtod, printf)
# 모두 KingSejong 코드로 쓰였다. 잘못된 입력은 오류를 던진다(strtol 처럼 앞부분만 읽고 멈추지 않는다).
# 실수_파싱 은 정확히 반올림하려고 긴 입력에서 stdlib/bigint 의 십진_실수 를 쓴다.

가져오기 "stdlib/bigint"

진법_숫자들 = 분리("0123456789abcdefghijklmnopqrstuvwxyz", "")

# 0-9, a-z, A-Z 의 자릿값. 아니면 -1
변환_자릿값 = 함수(글자) {
    c = 문자코드(글자)
    만약 (c >= 48 && c <= 57) {
        반환 c - 48
    }
    c = c | 32
    만약 (c >= 97 && c <= 122) {
        반환 c - 87
    }
    반환 -1
}

변환_공백인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c == 32 || (c >= 9 && c <= 13)
}

# 문자열을 진법(2~36)의 정수로. 앞뒤 공백, 부호, 16진수의 0x·2진수의 0b·8진수의 0o 를 받는다.
# 진법이 0 이면 접두어로 정한다(없으면 10). 자릿수가 없거나 남는 글자가 있거나 64비트를 넘으면 오류
정수_파싱 = 함수(텍스트, 진법) {
    글자들 = 분리(텍스트, "")
    n = 길이(글자들)
    i = 0
    반복 (i < n && 변환_공백인가(글자들[i])) {
        i = i + 1
    }
    음수 = 거짓
    만약 (i < n && (글자들[i] == "+" || 글자들[i] == "-")) {
        음수 = 글자들[i] == "-"
        i = i + 1
    }
    만약 (i + 1 < n && 글자들[i] == "0") {
        접두 = 소문자(글자들[i + 1])
        접두진법 = 0
        만약 (접두 == "x") {
            접두진법 = 16
        } 아니면 만약 (접두 == "b") {
            접두진법 = 2
        } 아니면 만약 (접두 == "o") {
            접두진법 = 8
        }
        만약 (접두진법 != 0 && (진법 == 0 || 진법 == 접두진법)) {
            진법 = 접두진법
            i = i + 2
        }
    }
    만약 (진법 == 0) {
        진법 = 10
    }
    만약 (진법 < 2 || 진법 > 36) {
        던지다 "진법은 2~36 이어야 한다: " + 문자열(진법)
    }
    # 음수 쪽으로 쌓는다: -9223372036854775808 은 양수로 나타낼 수 없다
    값 = 0
    자릿수 = 0
    반복 (i < n && !변환_공백인가(글자들[i])) {
        d = 변환_자릿값(글자들[i])
        만약 (d < 0 || d >= 진법) {
            던지다 "정수가 아닌 글자: " + 글자들[i]
        }
        값 = 값 * 진법 - d
        자릿수 = 자릿수 + 1
        i = i + 1
    }
    반복 (i < n && 변환_공백인가(글자들[i])) {
        i = i + 1
    }
    만약 (자릿수 == 0 || i < n) {
        던지다 "정수 형식이 아님: " + 텍스트
    }
    만약 (음수) {
        반환 값
    }
    반환 -값
}

# 정수를 진법(2~36) 문자열로. 소문자를 쓴다
정수_형식화 = 함수(값, 진법) {
    만약 (진법 < 2 || 진법 > 36) {
        던지다 "진법은 2~36 이어야 한다: " + 문자열(진법)
    }
    만약 (값 == 0) {
        반환 "0"
    }
    # 음수로 바꿔 나눈다 (가장 작은 정수도 다룬다)
    음수 = 값 < 0
    만약 (!음수) {
        값 = -값
    }
    거꾸로 = []
    반복 (값 != 0) {
        거꾸로에 덧붙인다(진법_숫자들[-(값 % 진법)])
        값 = 값 / 진법
    }
    만약 (음수) {
        거꾸로에 덧붙인다("-")
    }
    반환 결합된_문자열(거꾸로를 역순으로_나열한다)
}

# 문자열 배열을 하나로 (짧은 배열용. 긴 결과는 stdlib/bytes 의 조각_잇기)
결합된_문자열 = 함수(조각들) {
    결과 = ""
    조각들 각각에 대해 조각으로 {
        결과 = 결과 + 조각
    }
    반환 결과
}

# 10^0 ~ 10^22: 실수로 정확히 나타낼 수 있는 10 의 거듭제곱 (10.0 을 곱해 만들어도 오차가 없다)
십의_정확한_거듭제곱들 = [1.0]
i가 1부터 22까지 {
    십의_정확한_거듭제곱들에 덧붙인다(십의_정확한_거듭제곱들[i - 1] * 10.0)
}

# 10 의 거듭제곱 (실수). 22 까지는 정확하고, 그 위는 정확한 10^22 를 거듭 곱하므로 반올림이 몇 번 생긴다
십의_거듭제곱 = 함수(지수) {
    e = 지수
    만약 (e < 0) {
        e = -e
    }
    결과 = 십의_정확한_거듭제곱들[e % 22]
    큰단위 = e / 22
    반복 (큰단위 > 0) {
        결과 = 결과 * 1e22
        큰단위 = 큰단위 - 1
    }
    만약 (지수 < 0) {
        반환 1.0 / 결과
    }
    반환 결과
}

# 문자열을 실수로 ("3.14", "-1e-3", ".5", "2.", "inf"). 가장 가까운 실수로 정확히 반올림한다(C 의 strtod 와 같다)
실수_파싱 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    n = 길이(글자들)
    i = 0
    반복 (i < n && 변환_공백인가(글자들[i])) {
        i = i + 1
    }
    부호 = 1.0
    만약 (i < n && (글자들[i] == "+" || 글자들[i] == "-")) {
        만약 (글자들[i] == "-") {
            부호 = -1.0
        }
        i = i + 1
    }
    나머지 = 소문자(결합된_문자열(글자들[i부터 n미만]))
    만약 (나머지 == "inf" || 나머지 == "infinity") {
        반환 부호 * 1e308 * 10.0
    }
    # 앞쪽 0 을 뺀 유효 숫자를 모두 모은다. 몇 자리에서 자르면 반올림이 틀어질 수 있다
    가수_글자들 = []
    지수 = 0
    자릿수 = 0
    반복 (i < n && 숫자_글자(글자들[i])) {
        만약 (길이(가수_글자들) > 0 || 글자들[i] != "0") {
            가수_글자들에 덧붙인다(글자들[i])
        }
        자릿수 = 자릿수 + 1
        i = i + 1
    }
    만약 (i < n && 글자들[i] == ".") {
        i = i + 1
        반복 (i < n && 숫자_글자(글자들[i])) {
            만약 (길이(가수_글자들) > 0 || 글자들[i] != "0") {
                가수_글자들에 덧붙인다(글자들[i])
            }
            지수 = 지수 - 1
            자릿수 = 자릿수 + 1
            i = i + 1
        }
    }
    만약 (자릿수 == 0) {
        던지다 "실수 형식이 아님: " + 텍스트
    }
    만약 (i < n && (글자들[i] == "e" || 글자들[i] == "E")) {
        i = i + 1
        만약 (i >= n) {
            던지다 "실수 형식이 아님: " + 텍스트
        }
        지수_부분 = 결합된_문자열(글자들[i부터 n미만])
        지수 = 지수 + 정수_파싱(지수_부분, 10)
        i = n
    }
    반복 (i < n && 변환_공백인가(글자들[i])) {
        i = i + 1
    }
    만약 (i < n) {
        던지다 "실수 형식이 아님: " + 텍스트
    }
    가수_길이 = 길이(가수_글자들)
    만약 (가수_길이 == 0) {
        반환 부호 * 0.0
    }
    # 15 자리 이하 가수와 10^22 이하 10 의 거듭제곱은 실수로 정확하므로 나누기·곱하기 한 번만 반올림된다
    # (0.1 을 곱하면 0.3 이 0.30000000000000004 가 되므로 음수 지수는 나눈다)
    만약 (가수_길이 <= 15 && 지수 >= -22 && 지수 <= 22) {
        가수 = 정수(결합된_문자열(가수_글자들))
        만약 (지수 < 0) {
            반환 부호 * (실수(가수) / 십의_정확한_거듭제곱들[-지수])
        }
        반환 부호 * (실수(가수) * 십의_정확한_거듭제곱들[지수])
    }
    # 값은 10^(가수_길이 + 지수 - 1) 이상 10^(가수_길이 + 지수) 미만이다. 실수 범위를 크게 벗어나면 바로 끝낸다
    만약 (가수_길이 + 지수 > 310) {
        반환 부호 * 1e308 * 10.0
    }
    만약 (가수_길이 + 지수 < -324) {
        반환 부호 * 0.0
    }
    # 그 밖은 큰 정수로 정확히 나누고 반올림한다
    반환 부호 * 십진_실수(결합된_문자열(가수_글자들), 지수)
}

숫자_글자 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 48 && c <= 57
}

# 실수를 소수점 아래 자릿수만큼 고정 소수점 문자열로 (반올림은 0 에서 먼 쪽). printf 의 %.Nf
실수_형식화 = 함수(값, 자릿수) {
    # NaN 만 자기 자신과 같지 않다 (린터의 no-self-comparison 경고는 이 경우 맞지 않는다)
    만약 (값 != 값) {
        반환 "nan"
    }
    만약 (값 > 1e308 || 값 < -1e308) {
        만약 (값 < 0) {
            반환 "-inf"
        }
        반환 "inf"
    }
    부호 = ""
    만약 (값 < 0) {
        부호 = "-"
        값 = -값
    }
    배율 = 십의_거듭제곱(자릿수)
    # 정수 부분과 소수 부분을 따로 반올림해 큰 수에서도 정수 범위를 넘지 않게 한다
    정수부 = 내림(값)
    소수부 = 정수(내림((값 - 정수부) * 배율 + 0.5))
    만약 (소수부 >= 배율) {
        정수부 = 정수부 + 1
        소수부 = 0
    }
    결과 = 부호 + 정수_형식화(정수(정수부), 10)
    만약 (자릿수 > 0) {
        소수_문자열 = 정수_형식화(소수부, 10)
        반복 (길이(소수_문자열) < 자릿수) {
            소수_문자열 = "0" + 소수_문자열
        }
        결과 = 결과 + "." + 소수_문자열
    }
    반환 결과
}

# 너비에 맞춰 왼쪽(왼쪽정렬이 거짓) 또는 오른쪽을 채움 글자로 채운다
변환_채우기 = 함수(텍스트, 너비, 왼쪽정렬, 채움) {
    부족 = 너비 - 길이(텍스트)
    만약 (부족 <= 0) {
        반환 텍스트
    }
    여백 = 채움 * 부족
    만약 (왼쪽정렬) {
        반환 텍스트 + 여백
    }
    # 0 으로 채울 때는 부호 뒤에 채운다 (-0042)
    만약 (채움 == "0" && 길이(텍스트) > 0 && (텍스트[0] == "-" || 텍스트[0] == "+")) {
        반환 텍스트[0] + 여백 + 텍스트[1부터 길이(텍스트)미만]
    }
    반환 여백 + 텍스트
}

# 형식화 의 변환 하나: 값을 변환 글자(d i x X o b f s c)에 맞는 텍스트로 (채우기 전)
변환_한_값 = 함수(변환, 값, 정밀도, 더하기부호) {
    만약 (변환 == "s") {
        텍스트 = 문자열(값)
        만약 (정밀도 >= 0 && 길이(텍스트) > 정밀도) {
            반환 부분문자열(텍스트, 0, 정밀도)
        }
        반환 텍스트
    }
    만약 (변환 == "c") {
        만약 (타입(값) == "정수") {
            반환 코드문자(값)
        }
        반환 문자열(값)
    }
    진법 = {"d": 10, "i": 10, "x": 16, "X": 16, "o": 8, "b": 2}
    만약 (딕셔너리_포함(진법, 변환)) {
        만약 (타입(값) != "정수") {
            던지다 "%" + 변환 + " 에는 정수가 필요함: " + 문자열(값)
        }
        텍스트 = 정수_형식화(값, 진법[변환])
        만약 (변환 == "X") {
            텍스트 = 대문자(텍스트)
        }
    } 아니면 만약 (변환 == "f") {
        만약 (타입(값) != "정수" && 타입(값) != "실수") {
            던지다 "%f 에는 수가 필요함: " + 문자열(값)
        }
        만약 (정밀도 < 0) {
            정밀도 = 6
        }
        텍스트 = 실수_형식화(실수(값), 정밀도)
    } 아니면 {
        던지다 "지원하지 않는 변환: %" + 변환
    }
    만약 (더하기부호 && 값 >= 0) {
        반환 "+" + 텍스트
    }
    반환 텍스트
}

# printf 의 부분집합. %[-+0][너비][.정밀도]변환, 변환은 d i x X o b f s c %
# 값이 모자라거나 남거나 변환과 타입이 맞지 않으면 오류
형식화 = 함수(형식, 값들) {
    글자들 = 분리(형식, "")
    n = 길이(글자들)
    조각들 = []
    다음값 = 0
    i = 0
    반복 (i < n) {
        g = 글자들[i]
        만약 (g != "%") {
            조각들에 덧붙인다(g)
            i = i + 1
            계속
        }
        i = i + 1
        왼쪽정렬 = 거짓
        더하기부호 = 거짓
        채움 = " "
        반복 (i < n && (글자들[i] == "-" || 글자들[i] == "+" || 글자들[i] == "0")) {
            만약 (글자들[i] == "-") {
                왼쪽정렬 = 참
            } 아니면 만약 (글자들[i] == "+") {
                더하기부호 = 참
            } 아니면 {
                채움 = "0"
            }
            i = i + 1
        }
        너비 = 0
        반복 (i < n && 숫자_글자(글자들[i])) {
            너비 = 너비 * 10 + 변환_자릿값(글자들[i])
            i = i + 1
        }
        정밀도 = -1
        만약 (i < n && 글자들[i] == ".") {
            정밀도 = 0
            i = i + 1
            반복 (i < n && 숫자_글자(글자들[i])) {
                정밀도 = 정밀도 * 10 + 변환_자릿값(글자들[i])
                i = i + 1
            }
        }
        만약 (i >= n) {
            던지다 "형식 문자열이 % 에서 끝남: " + 형식
        }
        변환 = 글자들[i]
        i = i + 1
        만약 (변환 == "%") {
            조각들에 덧붙인다("%")
            계속
        }
        만약 (다음값 >= 길이(값들)) {
            던지다 "형식에 맞는 값이 모자람: " + 형식
        }
        값 = 값들[다음값]
        다음값 = 다음값 + 1
        텍스트 = 변환_한_값(변환, 값, 정밀도, 더하기부호)
        만약 (변환 == "s" || 변환 == "c") {
            채움 = " "
        }
        만약 (왼쪽정렬) {
            채움 = " "
        }
        조각들에 덧붙인다(변환_채우기(텍스트, 너비, 왼쪽정렬, 채움))
    }
    만약 (다음값 < 길이(값들)) {
        던지다 "형식에 쓰이지 않은 값이 있음: " + 형식
    }
    반환 결합된_문자열(조각들)
}
