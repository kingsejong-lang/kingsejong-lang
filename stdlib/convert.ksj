# convert 모듈
# KingSejong 표준 라이브러리 - 수와 문자열 변환 (C 의 strtol, strtod, printf)
# 모두 KingSejong 코드로 쓰였다. 잘못된 입력은 오류를 던진다(strtol 처럼 앞부분만 읽고 멈추지 않는다).
# 실수_파싱 은 정확히 반올림하려고 긴 입력에서 stdlib/bigint 의 십진_실수 를 쓴다.

가져오기 "stdlib/bigint"

진법_숫자들 = 분리("0123456789abcdefghijklmnopqrstuvwxyz", "")

# 0-9, a-z, A-Z 의 자릿값. 아니면 -1
변환_자릿값 = 함수(글자) {
    c = 문자코드(글자)
    만약 (c >= 48 && c <= 57) {
        반환 c - 48
    }
    c = c | 32
    만약 (c >= 97 && c <= 122) {
        반환 c - 87
    }
    반환 -1
}

변환_공백인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c == 32 || (c >= 9 && c <= 13)
}

# 글자들[i] 부터 공백을 건너뛴 위치
변환_공백_뒤 = 함수(글자들, i) {
    n = 길이(글자들)
    반복 (i < n && 변환_공백인가(글자들[i])) {
        i = i + 1
    }
    반환 i
}

# 글자들[i] 의 부호: [음수인가, 다음 위치]
변환_부호 = 함수(글자들, i) {
    만약 (i < 길이(글자들) && (글자들[i] == "+" || 글자들[i] == "-")) {
        반환 [글자들[i] == "-", i + 1]
    }
    반환 [거짓, i]
}

# 0x·0b·0o 접두어: [진법, 다음 위치]. 접두어가 없거나 주어진 진법(0 이 아니면)과 다르면 그대로 둔다
변환_접두어 = 함수(글자들, i, 진법) {
    만약 (i + 1 >= 길이(글자들) || 글자들[i] != "0") {
        반환 [진법, i]
    }
    접두어_진법 = {"x": 16, "b": 2, "o": 8}
    접두 = 소문자(글자들[i + 1])
    만약 (딕셔너리_포함(접두어_진법, 접두) && (진법 == 0 || 진법 == 접두어_진법[접두])) {
        반환 [접두어_진법[접두], i + 2]
    }
    반환 [진법, i]
}

# 공백이나 끝까지 진법의 자릿수를 읽는다: [음수로 쌓은 값, 자릿수, 다음 위치].
# 음수 쪽으로 쌓는다: -9223372036854775808 은 양수로 나타낼 수 없다
변환_자릿수_쌓기 = 함수(글자들, i, 진법) {
    n = 길이(글자들)
    값 = 0
    자릿수 = 0
    반복 (i < n && !변환_공백인가(글자들[i])) {
        d = 변환_자릿값(글자들[i])
        만약 (d < 0 || d >= 진법) {
            던지다 "정수가 아닌 글자: " + 글자들[i]
        }
        값 = 값 * 진법 - d
        자릿수 = 자릿수 + 1
        i = i + 1
    }
    반환 [값, 자릿수, i]
}

# 문자열을 진법(2~36)의 정수로. 앞뒤 공백, 부호, 16진수의 0x·2진수의 0b·8진수의 0o 를 받는다.
# 진법이 0 이면 접두어로 정한다(없으면 10). 자릿수가 없거나 남는 글자가 있거나 64비트를 넘으면 오류
정수_파싱 = 함수(텍스트, 진법) {
    글자들 = 분리(텍스트, "")
    부호 = 변환_부호(글자들, 변환_공백_뒤(글자들, 0))
    접두어 = 변환_접두어(글자들, 부호[1], 진법)
    진법 = 접두어[0]
    만약 (진법 == 0) {
        진법 = 10
    }
    만약 (진법 < 2 || 진법 > 36) {
        던지다 "진법은 2~36 이어야 한다: " + 문자열(진법)
    }
    쌓기 = 변환_자릿수_쌓기(글자들, 접두어[1], 진법)
    만약 (쌓기[1] == 0 || 변환_공백_뒤(글자들, 쌓기[2]) < 길이(글자들)) {
        던지다 "정수 형식이 아님: " + 텍스트
    }
    만약 (부호[0]) {
        반환 쌓기[0]
    }
    반환 -쌓기[0]
}

# 정수를 진법(2~36) 문자열로. 소문자를 쓴다
정수_형식화 = 함수(값, 진법) {
    만약 (진법 < 2 || 진법 > 36) {
        던지다 "진법은 2~36 이어야 한다: " + 문자열(진법)
    }
    만약 (값 == 0) {
        반환 "0"
    }
    # 음수로 바꿔 나눈다 (가장 작은 정수도 다룬다)
    음수 = 값 < 0
    만약 (!음수) {
        값 = -값
    }
    거꾸로 = []
    반복 (값 != 0) {
        거꾸로에 덧붙인다(진법_숫자들[-(값 % 진법)])
        값 = 값 / 진법
    }
    만약 (음수) {
        거꾸로에 덧붙인다("-")
    }
    반환 결합된_문자열(거꾸로를 역순으로_나열한다)
}

# 문자열 배열을 하나로 (짧은 배열용. 긴 결과는 stdlib/bytes 의 조각_잇기)
결합된_문자열 = 함수(조각들) {
    결과 = ""
    조각들 각각에 대해 조각으로 {
        결과 = 결과 + 조각
    }
    반환 결과
}

# 10^0 ~ 10^22: 실수로 정확히 나타낼 수 있는 10 의 거듭제곱 (10.0 을 곱해 만들어도 오차가 없다)
십의_정확한_거듭제곱들 = [1.0]
i가 1부터 22까지 {
    십의_정확한_거듭제곱들에 덧붙인다(십의_정확한_거듭제곱들[i - 1] * 10.0)
}

# 10 의 거듭제곱 (실수). 22 까지는 정확하고, 그 위는 정확한 10^22 를 거듭 곱하므로 반올림이 몇 번 생긴다
십의_거듭제곱 = 함수(지수) {
    e = 지수
    만약 (e < 0) {
        e = -e
    }
    결과 = 십의_정확한_거듭제곱들[e % 22]
    큰단위 = e / 22
    반복 (큰단위 > 0) {
        결과 = 결과 * 1e22
        큰단위 = 큰단위 - 1
    }
    만약 (지수 < 0) {
        반환 1.0 / 결과
    }
    반환 결과
}

# 숫자를 읽어 앞쪽 0 을 뺀 유효 숫자를 가수_글자들 에 덧붙인다(제자리). 다음 위치를 돌려준다
변환_숫자_모으기 = 함수(글자들, i, 가수_글자들) {
    n = 길이(글자들)
    반복 (i < n && 숫자_글자(글자들[i])) {
        만약 (길이(가수_글자들) > 0 || 글자들[i] != "0") {
            가수_글자들에 덧붙인다(글자들[i])
        }
        i = i + 1
    }
    반환 i
}

# 정수부와 소수부: [유효 숫자 글자들, 소수점 아래 자릿수만큼의 음의 지수, 읽은 숫자 수, 다음 위치].
# 몇 자리에서 자르면 반올림이 틀어질 수 있으므로 유효 숫자를 모두 모은다
변환_가수_읽기 = 함수(글자들, i) {
    가수_글자들 = []
    끝 = 변환_숫자_모으기(글자들, i, 가수_글자들)
    자릿수 = 끝 - i
    지수 = 0
    만약 (끝 < 길이(글자들) && 글자들[끝] == ".") {
        소수_끝 = 변환_숫자_모으기(글자들, 끝 + 1, 가수_글자들)
        지수 = 끝 + 1 - 소수_끝
        자릿수 = 자릿수 - 지수
        끝 = 소수_끝
    }
    반환 [가수_글자들, 지수, 자릿수, 끝]
}

# e 지수: [지수, 다음 위치]. e 가 없으면 [0, i]
변환_지수_읽기 = 함수(글자들, i, 텍스트) {
    n = 길이(글자들)
    만약 (i >= n || (글자들[i] != "e" && 글자들[i] != "E")) {
        반환 [0, i]
    }
    시작 = i + 1
    만약 (시작 >= n) {
        던지다 "실수 형식이 아님: " + 텍스트
    }
    반환 [정수_파싱(결합된_문자열(글자들[시작부터 n미만]), 10), n]
}

# 유효 숫자 × 10^지수 에 가장 가까운 0 이상의 실수
변환_십진_값 = 함수(가수_글자들, 지수) {
    가수_길이 = 길이(가수_글자들)
    만약 (가수_길이 == 0) {
        반환 0.0
    }
    # 15 자리 이하 가수와 10^22 이하 10 의 거듭제곱은 실수로 정확하므로 나누기·곱하기 한 번만 반올림된다
    # (0.1 을 곱하면 0.3 이 0.30000000000000004 가 되므로 음수 지수는 나눈다)
    만약 (가수_길이 <= 15 && 지수 >= -22 && 지수 <= 22) {
        가수 = 실수(정수(결합된_문자열(가수_글자들)))
        만약 (지수 < 0) {
            반환 가수 / 십의_정확한_거듭제곱들[-지수]
        }
        반환 가수 * 십의_정확한_거듭제곱들[지수]
    }
    # 값은 10^(가수_길이 + 지수 - 1) 이상 10^(가수_길이 + 지수) 미만이다. 실수 범위를 크게 벗어나면 바로 끝낸다
    만약 (가수_길이 + 지수 > 310) {
        반환 1e308 * 10.0
    }
    만약 (가수_길이 + 지수 < -324) {
        반환 0.0
    }
    # 그 밖은 큰 정수로 정확히 나누고 반올림한다
    반환 십진_실수(결합된_문자열(가수_글자들), 지수)
}

# 문자열을 실수로 ("3.14", "-1e-3", ".5", "2.", "inf"). 가장 가까운 실수로 정확히 반올림한다(C 의 strtod 와 같다)
실수_파싱 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    n = 길이(글자들)
    부호_읽기 = 변환_부호(글자들, 변환_공백_뒤(글자들, 0))
    부호 = 1.0
    만약 (부호_읽기[0]) {
        부호 = -1.0
    }
    i = 부호_읽기[1]
    나머지 = 소문자(결합된_문자열(글자들[i부터 n미만]))
    만약 (나머지 == "inf" || 나머지 == "infinity") {
        반환 부호 * 1e308 * 10.0
    }
    가수 = 변환_가수_읽기(글자들, i)
    만약 (가수[2] == 0) {
        던지다 "실수 형식이 아님: " + 텍스트
    }
    지수 = 변환_지수_읽기(글자들, 가수[3], 텍스트)
    만약 (변환_공백_뒤(글자들, 지수[1]) < n) {
        던지다 "실수 형식이 아님: " + 텍스트
    }
    반환 부호 * 변환_십진_값(가수[0], 가수[1] + 지수[0])
}

숫자_글자 = 함수(글자) {
    c = 문자코드(글자)
    반환 c >= 48 && c <= 57
}

# 실수를 소수점 아래 자릿수만큼 고정 소수점 문자열로 (반올림은 0 에서 먼 쪽). printf 의 %.Nf
실수_형식화 = 함수(값, 자릿수) {
    # NaN 만 자기 자신과 같지 않다
    만약 (값 != 값) {
        반환 "nan"
    }
    만약 (값 > 1e308 || 값 < -1e308) {
        만약 (값 < 0) {
            반환 "-inf"
        }
        반환 "inf"
    }
    부호 = ""
    만약 (값 < 0) {
        부호 = "-"
        값 = -값
    }
    배율 = 십의_거듭제곱(자릿수)
    # 정수 부분과 소수 부분을 따로 반올림해 큰 수에서도 정수 범위를 넘지 않게 한다
    정수부 = 내림(값)
    소수부 = 정수(내림((값 - 정수부) * 배율 + 0.5))
    만약 (소수부 >= 배율) {
        정수부 = 정수부 + 1
        소수부 = 0
    }
    결과 = 부호 + 정수_형식화(정수(정수부), 10)
    만약 (자릿수 > 0) {
        소수_문자열 = 정수_형식화(소수부, 10)
        반복 (길이(소수_문자열) < 자릿수) {
            소수_문자열 = "0" + 소수_문자열
        }
        결과 = 결과 + "." + 소수_문자열
    }
    반환 결과
}

# 너비에 맞춰 왼쪽(왼쪽정렬이 거짓) 또는 오른쪽을 채움 글자로 채운다
변환_채우기 = 함수(텍스트, 너비, 왼쪽정렬, 채움) {
    부족 = 너비 - 길이(텍스트)
    만약 (부족 <= 0) {
        반환 텍스트
    }
    여백 = 채움 * 부족
    만약 (왼쪽정렬) {
        반환 텍스트 + 여백
    }
    # 0 으로 채울 때는 부호 뒤에 채운다 (-0042)
    만약 (채움 == "0" && 길이(텍스트) > 0 && (텍스트[0] == "-" || 텍스트[0] == "+")) {
        반환 텍스트[0] + 여백 + 텍스트[1부터 길이(텍스트)미만]
    }
    반환 여백 + 텍스트
}

# 수 변환(d i x X o b f)의 텍스트 (부호 붙이기·채우기 전)
변환_수_값 = 함수(변환, 값, 정밀도) {
    진법 = {"d": 10, "i": 10, "x": 16, "X": 16, "o": 8, "b": 2}
    만약 (딕셔너리_포함(진법, 변환)) {
        만약 (타입(값) != "정수") {
            던지다 "%" + 변환 + " 에는 정수가 필요함: " + 문자열(값)
        }
        텍스트 = 정수_형식화(값, 진법[변환])
        만약 (변환 == "X") {
            반환 대문자(텍스트)
        }
        반환 텍스트
    }
    만약 (변환 != "f") {
        던지다 "지원하지 않는 변환: %" + 변환
    }
    만약 (타입(값) != "정수" && 타입(값) != "실수") {
        던지다 "%f 에는 수가 필요함: " + 문자열(값)
    }
    만약 (정밀도 < 0) {
        정밀도 = 6
    }
    반환 실수_형식화(실수(값), 정밀도)
}

# 형식화 의 변환 하나: 값을 변환 글자(d i x X o b f s c)에 맞는 텍스트로 (채우기 전)
변환_한_값 = 함수(변환, 값, 정밀도, 더하기부호) {
    만약 (변환 == "s") {
        텍스트 = 문자열(값)
        만약 (정밀도 >= 0 && 길이(텍스트) > 정밀도) {
            반환 부분문자열(텍스트, 0, 정밀도)
        }
        반환 텍스트
    }
    만약 (변환 == "c") {
        만약 (타입(값) == "정수") {
            반환 코드문자(값)
        }
        반환 문자열(값)
    }
    텍스트 = 변환_수_값(변환, 값, 정밀도)
    만약 (더하기부호 && 값 >= 0) {
        반환 "+" + 텍스트
    }
    반환 텍스트
}

# 10 진 숫자들: [값, 다음 위치]. 숫자가 없으면 [0, i]
변환_십진_읽기 = 함수(글자들, i) {
    n = 길이(글자들)
    값 = 0
    반복 (i < n && 숫자_글자(글자들[i])) {
        값 = 값 * 10 + 변환_자릿값(글자들[i])
        i = i + 1
    }
    반환 [값, i]
}

# % 뒤의 [-+0][너비][.정밀도]변환 을 읽는다. 정밀도가 없으면 -1, "다음" 은 변환 글자 다음 위치
변환_명세_읽기 = 함수(글자들, i, 형식) {
    n = 길이(글자들)
    명세 = {"왼쪽정렬": 거짓, "더하기부호": 거짓, "채움": " ", "정밀도": -1}
    반복 (i < n && (글자들[i] == "-" || 글자들[i] == "+" || 글자들[i] == "0")) {
        만약 (글자들[i] == "-") {
            명세["왼쪽정렬"] = 참
        } 아니면 만약 (글자들[i] == "+") {
            명세["더하기부호"] = 참
        } 아니면 {
            명세["채움"] = "0"
        }
        i = i + 1
    }
    너비 = 변환_십진_읽기(글자들, i)
    명세["너비"] = 너비[0]
    i = 너비[1]
    만약 (i < n && 글자들[i] == ".") {
        정밀도 = 변환_십진_읽기(글자들, i + 1)
        명세["정밀도"] = 정밀도[0]
        i = 정밀도[1]
    }
    만약 (i >= n) {
        던지다 "형식 문자열이 % 에서 끝남: " + 형식
    }
    명세["변환"] = 글자들[i]
    명세["다음"] = i + 1
    반환 명세
}

# 읽은 명세로 값 하나를 쓴다. 글자 변환(s c)과 왼쪽 정렬은 0 으로 채우지 않는다
변환_명세_적용 = 함수(명세, 값) {
    변환 = 명세["변환"]
    텍스트 = 변환_한_값(변환, 값, 명세["정밀도"], 명세["더하기부호"])
    채움 = 명세["채움"]
    만약 (변환 == "s" || 변환 == "c" || 명세["왼쪽정렬"]) {
        채움 = " "
    }
    반환 변환_채우기(텍스트, 명세["너비"], 명세["왼쪽정렬"], 채움)
}

# printf 의 부분집합. %[-+0][너비][.정밀도]변환, 변환은 d i x X o b f s c %
# 값이 모자라거나 남거나 변환과 타입이 맞지 않으면 오류
형식화 = 함수(형식, 값들) {
    글자들 = 분리(형식, "")
    n = 길이(글자들)
    조각들 = []
    다음값 = 0
    i = 0
    반복 (i < n) {
        만약 (글자들[i] != "%") {
            조각들에 덧붙인다(글자들[i])
            i = i + 1
            계속
        }
        명세 = 변환_명세_읽기(글자들, i + 1, 형식)
        i = 명세["다음"]
        만약 (명세["변환"] == "%") {
            조각들에 덧붙인다("%")
            계속
        }
        만약 (다음값 >= 길이(값들)) {
            던지다 "형식에 맞는 값이 모자람: " + 형식
        }
        조각들에 덧붙인다(변환_명세_적용(명세, 값들[다음값]))
        다음값 = 다음값 + 1
    }
    만약 (다음값 < 길이(값들)) {
        던지다 "형식에 쓰이지 않은 값이 있음: " + 형식
    }
    반환 결합된_문자열(조각들)
}
