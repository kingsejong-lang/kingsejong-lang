# date 모듈
# KingSejong 표준 라이브러리 - 달력 계산과 날짜 형식화 (C 의 gmtime, timegm, strftime)
# 타임스탬프는 1970-01-01 00:00:00 UTC 부터 센 초다(윤초 없음). 지역 시간은 시차(초)를 더해서 다룬다:
# 한국 표준시는 32400. 달력은 그레고리력을 과거로도 늘려 쓴다(서기 0 년 = 기원전 1 년).
# 일수 ↔ 날짜 변환은 Howard Hinnant 의 days_from_civil / civil_from_days 알고리즘이다.
# 모두 KingSejong 코드로 쓰였다.

날짜_요일_약자 = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
날짜_요일_이름 = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
날짜_월_약자 = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
날짜_월_이름 = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
날짜_한글_요일 = ["일", "월", "화", "수", "목", "금", "토"]

# 날짜_형식화 의 지정자 표. 숫자 칸을 채워 쓰는 지정자: [칸 이름, 폭, 채움 글자]
날짜_숫자_지정자 = {
    "Y": ["년", 4, "0"],
    "m": ["월", 2, "0"],
    "d": ["일", 2, "0"],
    "e": ["일", 2, " "],
    "H": ["시", 2, "0"],
    "M": ["분", 2, "0"],
    "S": ["초", 2, "0"],
    "j": ["연중일", 3, "0"]
}
# 이름 표에서 고르는 지정자: [이름 표, 칸 이름, 칸 값에서 뺄 수]
날짜_이름_지정자 = {
    "a": [날짜_요일_약자, "요일", 0],
    "A": [날짜_요일_이름, "요일", 0],
    "K": [날짜_한글_요일, "요일", 0],
    "b": [날짜_월_약자, "월", 1],
    "B": [날짜_월_이름, "월", 1]
}
# 다른 지정자를 묶은 지정자
날짜_묶음_지정자 = {"F": "%Y-%m-%d", "T": "%H:%M:%S"}

# 아래로 버리는 나눗셈 (나누는 수는 양수). 언어의 / 는 0 쪽으로 버려서 음수 타임스탬프에서 하루가 어긋난다
날짜_내림_나누기 = 함수(a, b) {
    몫 = a / b
    만약 (a % b < 0) {
        몫 = 몫 - 1
    }
    반환 몫
}

윤년인가 = 함수(년) {
    반환 (년 % 4 == 0 && 년 % 100 != 0) || 년 % 400 == 0
}

월_일수 = 함수(년, 월) {
    만약 (월 < 1 || 월 > 12) {
        던지다 "월_일수: 월은 1~12: " + 문자열(월)
    }
    만약 (월 == 2) {
        만약 (윤년인가(년)) {
            반환 29
        }
        반환 28
    }
    만약 (월 == 4 || 월 == 6 || 월 == 9 || 월 == 11) {
        반환 30
    }
    반환 31
}

# 1970-01-01 부터 센 날 수 (그 전은 음수)
날짜_에서_일수 = 함수(년, 월, 일) {
    y = 년
    만약 (월 <= 2) {
        y = y - 1
    }
    시대 = 날짜_내림_나누기(y, 400)
    시대년 = y - 시대 * 400
    # 3 월을 0 으로 세면 2 월(윤일)이 해의 끝에 온다
    m = 월 + 9
    만약 (월 > 2) {
        m = 월 - 3
    }
    연중 = (153 * m + 2) / 5 + 일 - 1
    시대일 = 시대년 * 365 + 시대년 / 4 - 시대년 / 100 + 연중
    반환 시대 * 146097 + 시대일 - 719468
}

# 날 수 → [년, 월, 일]
일수_에서_날짜 = 함수(일수) {
    z = 일수 + 719468
    시대 = 날짜_내림_나누기(z, 146097)
    시대일 = z - 시대 * 146097
    시대년 = (시대일 - 시대일 / 1460 + 시대일 / 36524 - 시대일 / 146096) / 365
    연중 = 시대일 - (365 * 시대년 + 시대년 / 4 - 시대년 / 100)
    m = (5 * 연중 + 2) / 153
    일 = 연중 - (153 * m + 2) / 5 + 1
    월 = m + 3
    만약 (m >= 10) {
        월 = m - 9
    }
    년 = 시대년 + 시대 * 400
    만약 (월 <= 2) {
        년 = 년 + 1
    }
    반환 [년, 월, 일]
}

# 0 = 일요일 … 6 = 토요일. 1970-01-01 은 목요일(4)
요일 = 함수(일수) {
    반환 (일수 % 7 + 11) % 7
}

# 타임스탬프 + 시차(초) → {"년", "월", "일", "시", "분", "초", "요일", "연중일"} (C 의 gmtime 결과 struct tm)
날짜_분해 = 함수(타임스탬프, 시차) {
    t = 타임스탬프 + 시차
    일수 = 날짜_내림_나누기(t, 86400)
    초 = t - 일수 * 86400
    날짜 = 일수_에서_날짜(일수)
    반환 {
        "년": 날짜[0], "월": 날짜[1], "일": 날짜[2],
        "시": 초 / 3600, "분": (초 % 3600) / 60, "초": 초 % 60,
        "요일": 요일(일수),
        "연중일": 일수 - 날짜_에서_일수(날짜[0], 1, 1) + 1
    }
}

# 날짜와 시각(UTC) → 타임스탬프 (C 의 timegm). 범위를 벗어난 값은 오류다(timegm 처럼 넘겨 계산하지 않는다)
타임스탬프_만들기 = 함수(년, 월, 일, 시, 분, 초) {
    만약 (일 < 1 || 일 > 월_일수(년, 월)) {
        던지다 "타임스탬프_만들기: 그 달에 없는 날: " + 문자열(년) + "-" + 문자열(월) + "-" + 문자열(일)
    }
    만약 (시 < 0 || 시 > 23 || 분 < 0 || 분 > 59 || 초 < 0 || 초 > 59) {
        던지다 "타임스탬프_만들기: 시각 범위 밖: " + 문자열(시) + ":" + 문자열(분) + ":" + 문자열(초)
    }
    반환 날짜_에서_일수(년, 월, 일) * 86400 + 시 * 3600 + 분 * 60 + 초
}

# 0 이상의 정수를 폭에 맞춰 채움 글자로 채운다. 음수는 부호를 앞에 둔다
날짜_채우기 = 함수(값, 폭, 채움) {
    부호 = ""
    n = 값
    만약 (n < 0) {
        부호 = "-"
        n = -n
    }
    텍스트 = 문자열(n)
    반복 (길이(텍스트) < 폭) {
        텍스트 = 채움 + 텍스트
    }
    반환 부호 + 텍스트
}

# 시차(초)를 +HHMM 으로
날짜_시차_문자열 = 함수(시차) {
    분 = 시차 / 60
    만약 (분 < 0) {
        반환 "-" + 날짜_채우기(-분 / 60, 2, "0") + 날짜_채우기(-분 % 60, 2, "0")
    }
    반환 "+" + 날짜_채우기(분 / 60, 2, "0") + 날짜_채우기(분 % 60, 2, "0")
}

# 표에 없는 지정자: %y %I %p %u %w %s %z %%
날짜_기타_지정자 = 함수(글자, 칸, 타임스탬프, 시차) {
    만약 (글자 == "y") {
        반환 날짜_채우기(((칸["년"] % 100) + 100) % 100, 2, "0")
    }
    만약 (글자 == "I") {
        # 0 시와 12 시는 12, 13 시는 1
        반환 날짜_채우기((칸["시"] + 11) % 12 + 1, 2, "0")
    }
    만약 (글자 == "p") {
        만약 (칸["시"] < 12) {
            반환 "AM"
        }
        반환 "PM"
    }
    만약 (글자 == "u") {
        # 월요일 1 … 일요일 7
        반환 문자열((칸["요일"] + 6) % 7 + 1)
    }
    만약 (글자 == "w") {
        반환 문자열(칸["요일"])
    }
    만약 (글자 == "s") {
        반환 문자열(타임스탬프)
    }
    만약 (글자 == "z") {
        반환 날짜_시차_문자열(시차)
    }
    만약 (글자 == "%") {
        반환 "%"
    }
    던지다 "날짜_형식화: 모르는 지정자: %" + 글자
}

# 형식 지정자 하나(% 뒤 글자)를 바꾼다
날짜_지정자 = 함수(글자, 칸, 타임스탬프, 시차) {
    만약 (딕셔너리_포함(날짜_숫자_지정자, 글자)) {
        규칙 = 날짜_숫자_지정자[글자]
        반환 날짜_채우기(칸[규칙[0]], 규칙[1], 규칙[2])
    }
    만약 (딕셔너리_포함(날짜_이름_지정자, 글자)) {
        규칙 = 날짜_이름_지정자[글자]
        반환 규칙[0][칸[규칙[1]] - 규칙[2]]
    }
    만약 (딕셔너리_포함(날짜_묶음_지정자, 글자)) {
        반환 날짜_칸_형식화(칸, 날짜_묶음_지정자[글자], 타임스탬프, 시차)
    }
    반환 날짜_기타_지정자(글자, 칸, 타임스탬프, 시차)
}

# 분해한 칸으로 형식 문자열을 채운다
날짜_칸_형식화 = 함수(칸, 형식, 타임스탬프, 시차) {
    글자들 = 분리(형식, "")
    n = 길이(글자들)
    결과 = ""
    i = 0
    반복 (i < n) {
        만약 (글자들[i] == "%") {
            만약 (i + 1 >= n) {
                던지다 "날짜_형식화: 형식이 % 로 끝남"
            }
            결과 = 결과 + 날짜_지정자(글자들[i + 1], 칸, 타임스탬프, 시차)
            i = i + 2
        } 아니면 {
            결과 = 결과 + 글자들[i]
            i = i + 1
        }
    }
    반환 결과
}

# C 의 strftime (C 로케일). 지정자: %Y %y %m %d %e %H %I %M %S %p %j %a %A %b %B %u %w %F %T %s %z %%,
# 그리고 한글 요일 %K (일 … 토)
날짜_형식화 = 함수(타임스탬프, 형식, 시차) {
    반환 날짜_칸_형식화(날짜_분해(타임스탬프, 시차), 형식, 타임스탬프, 시차)
}

# 고정 길이 10 진수 조각을 읽는다
날짜_숫자_읽기 = 함수(글자들, 시작, 개수, 텍스트) {
    만약 (시작 + 개수 > 길이(글자들)) {
        던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
    }
    값 = 0
    j = 시작
    반복 (j < 시작 + 개수) {
        코드 = 문자코드(글자들[j])
        만약 (코드 < 48 || 코드 > 57) {
            던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
        }
        값 = 값 * 10 + (코드 - 48)
        j = j + 1
    }
    반환 값
}

# 날짜 뒤의 "T09:30" 이나 " 09:30:00" 시각: [시, 분, 초, 다음 위치]. 시각이 없으면 [0, 0, 0, i]
날짜_시각_읽기 = 함수(글자들, i, 텍스트) {
    n = 길이(글자들)
    만약 (i >= n || (글자들[i] != "T" && 글자들[i] != " ")) {
        반환 [0, 0, 0, i]
    }
    시 = 날짜_숫자_읽기(글자들, i + 1, 2, 텍스트)
    만약 (i + 3 >= n || 글자들[i + 3] != ":") {
        던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
    }
    분 = 날짜_숫자_읽기(글자들, i + 4, 2, 텍스트)
    만약 (i + 6 < n && 글자들[i + 6] == ":") {
        반환 [시, 분, 날짜_숫자_읽기(글자들, i + 7, 2, 텍스트), i + 9]
    }
    반환 [시, 분, 0, i + 6]
}

# 끝의 "Z" 나 "+09:00"·"-05:00" 시차: [시차(초), 다음 위치]. 시차가 없으면 [0, i]
날짜_시차_읽기 = 함수(글자들, i, 텍스트) {
    n = 길이(글자들)
    만약 (i < n && 글자들[i] == "Z") {
        반환 [0, i + 1]
    }
    만약 (i >= n || (글자들[i] != "+" && 글자들[i] != "-")) {
        반환 [0, i]
    }
    시차 = 날짜_숫자_읽기(글자들, i + 1, 2, 텍스트) * 3600
    만약 (i + 3 >= n || 글자들[i + 3] != ":") {
        던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
    }
    시차 = 시차 + 날짜_숫자_읽기(글자들, i + 4, 2, 텍스트) * 60
    만약 (글자들[i] == "-") {
        반환 [-시차, i + 6]
    }
    반환 [시차, i + 6]
}

# ISO 8601 → 타임스탬프. "2026-11-04", "2026-11-04T09:30:00", 끝에 "Z" 나 "+09:00"·"-05:00" 시차.
# 시차가 없으면 UTC 로 읽는다. 날짜와 시각 사이는 T 나 공백
날짜_파싱 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    n = 길이(글자들)
    년 = 날짜_숫자_읽기(글자들, 0, 4, 텍스트)
    만약 (n < 10 || 글자들[4] != "-" || 글자들[7] != "-") {
        던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
    }
    월 = 날짜_숫자_읽기(글자들, 5, 2, 텍스트)
    일 = 날짜_숫자_읽기(글자들, 8, 2, 텍스트)
    시각 = 날짜_시각_읽기(글자들, 10, 텍스트)
    시차 = 날짜_시차_읽기(글자들, 시각[3], 텍스트)
    만약 (시차[1] != n) {
        던지다 "날짜_파싱: ISO 8601 형식이 아님: " + 텍스트
    }
    반환 타임스탬프_만들기(년, 월, 일, 시각[0], 시각[1], 시각[2]) - 시차[0]
}
