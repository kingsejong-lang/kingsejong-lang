# random 모듈
# KingSejong 표준 라이브러리 - 씨앗으로 재현할 수 있는 난수 생성기 (C 의 srand/rand 자리)
# 생성기는 xoshiro256** (Blackman, Vigna) 이고 씨앗은 SplitMix64 로 펼친다. 생성기는 상태 4 개를 담은 배열이며
# 난수를 뽑을 때마다 제자리에서 바뀐다. 같은 씨앗은 언제나 같은 수열을 낸다. 암호용이 아니다.
# 64 비트 감싸 도는 곱셈·덧셈은 감싸곱하기·감싸더하기 로, 부호 없는 오른쪽 이동은 논리_밀기 로 한다.
# 모두 KingSejong 코드로 쓰였다.

# 부호 없는 오른쪽 이동 (C 의 uint64_t >>). 언어의 >> 는 부호 비트를 채운다
논리_밀기 = 함수(x, k) {
    만약 (k == 0) {
        반환 x
    }
    반환 (x >> k) & ~(-1 << (64 - k))
}

# 64 비트 왼쪽 회전
왼쪽_회전 = 함수(x, k) {
    반환 (x << k) | 논리_밀기(x, 64 - k)
}

# SplitMix64 한 단계: [다음 상태, 출력]
SplitMix64_다음 = 함수(상태) {
    다음상태 = 감싸더하기(상태, 0x9e3779b97f4a7c15)
    z = 다음상태
    z = 감싸곱하기(z ^ 논리_밀기(z, 30), 0xbf58476d1ce4e5b9)
    z = 감싸곱하기(z ^ 논리_밀기(z, 27), 0x94d049bb133111eb)
    반환 [다음상태, z ^ 논리_밀기(z, 31)]
}

# 씨앗(정수)으로 생성기를 만든다
난수_생성기 = 함수(씨앗) {
    생성기 = []
    상태 = 씨앗
    i가 1부터 4까지 {
        단계 = SplitMix64_다음(상태)
        상태 = 단계[0]
        생성기에 덧붙인다(단계[1])
    }
    반환 생성기
}

# 64 비트 난수 하나 (음수일 수 있다: 부호 없는 값의 비트 패턴이다)
난수_다음 = 함수(생성기) {
    결과 = 감싸곱하기(왼쪽_회전(감싸곱하기(생성기[1], 5), 7), 9)
    t = 생성기[1] << 17
    생성기[2] = 생성기[2] ^ 생성기[0]
    생성기[3] = 생성기[3] ^ 생성기[1]
    생성기[1] = 생성기[1] ^ 생성기[2]
    생성기[0] = 생성기[0] ^ 생성기[3]
    생성기[2] = 생성기[2] ^ t
    생성기[3] = 왼쪽_회전(생성기[3], 45)
    반환 결과
}

# 최소 이상 최대 이하의 고른 정수. 나머지 연산의 치우침은 거절 표본으로 없앤다
난수_범위 = 함수(생성기, 최소, 최대) {
    만약 (최소 > 최대) {
        던지다 "난수_범위: 최소가 최대보다 큼"
    }
    # 개수(최대 - 최소 + 1)가 64 비트 정수에 들어가야 한다. 최소 < 0 이면 차를 구하기 전에 넘침을 막는다
    만약 (최소 < 0 && 최대 >= 9223372036854775807 + 최소) {
        던지다 "난수_범위: 범위가 2^63 이상"
    }
    만약 (최대 - 최소 == 9223372036854775807) {
        던지다 "난수_범위: 범위가 2^63 이상"
    }
    개수 = 최대 - 최소 + 1
    # 63 비트 난수 x 가 2^63 mod 개수 보다 작으면 버린다. 남는 수의 개수가 개수 의 배수가 된다
    버림 = ((9223372036854775807 % 개수) + 1) % 개수
    반복 (참) {
        x = 논리_밀기(난수_다음(생성기), 1)
        만약 (x >= 버림) {
            반환 최소 + x % 개수
        }
    }
}

# 0 이상 1 미만의 고른 실수: 위 53 비트를 2^53 으로 나눈다 (모든 값이 정확히 나타난다)
난수_실수 = 함수(생성기) {
    반환 실수(논리_밀기(난수_다음(생성기), 11)) / 9007199254740992.0
}

# 배열을 제자리에서 섞는다 (Fisher-Yates)
난수_섞기 = 함수(생성기, 배열) {
    i = 길이(배열) - 1
    반복 (i > 0) {
        j = 난수_범위(생성기, 0, i)
        임시 = 배열[i]
        배열[i] = 배열[j]
        배열[j] = 임시
        i = i - 1
    }
    반환 배열
}

난수_선택 = 함수(생성기, 배열) {
    만약 (길이(배열) == 0) {
        던지다 "난수_선택: 빈 배열"
    }
    반환 배열[난수_범위(생성기, 0, 길이(배열) - 1)]
}
