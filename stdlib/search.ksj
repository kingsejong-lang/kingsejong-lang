# search 모듈
# KingSejong 표준 라이브러리 - 정렬된 배열 탐색과 제자리 정렬 (C 의 bsearch, qsort)
# 비교 함수는 정렬한다(비교 함수) 와 같다: a 가 앞이면 음수, 뒤면 양수, 같으면 0.
# 모두 KingSejong 코드로 쓰였다.

# 수·문자열을 크기 순으로 비교하는 기본 비교 함수
기본_비교 = 함수(a, b) {
    만약 (a < b) {
        반환 -1
    }
    만약 (a > b) {
        반환 1
    }
    반환 0
}

# 값보다 앞서지 않는 첫 위치 (C++ lower_bound). 모두 앞서면 길이
하한 = 함수(배열, 값, 비교) {
    낮음 = 0
    높음 = 길이(배열)
    반복 (낮음 < 높음) {
        중간 = (낮음 + 높음) / 2
        만약 (비교(배열[중간], 값) < 0) {
            낮음 = 중간 + 1
        } 아니면 {
            높음 = 중간
        }
    }
    반환 낮음
}

# 값보다 뒤에 오는 첫 위치 (C++ upper_bound)
상한 = 함수(배열, 값, 비교) {
    낮음 = 0
    높음 = 길이(배열)
    반복 (낮음 < 높음) {
        중간 = (낮음 + 높음) / 2
        만약 (비교(값, 배열[중간]) < 0) {
            높음 = 중간
        } 아니면 {
            낮음 = 중간 + 1
        }
    }
    반환 낮음
}

# 정렬된 배열에서 값과 같은 요소의 위치 (bsearch). 여럿이면 첫 위치, 없으면 -1
이진_탐색 = 함수(배열, 값, 비교) {
    i = 하한(배열, 값, 비교)
    만약 (i < 길이(배열) && 비교(배열[i], 값) == 0) {
        반환 i
    }
    반환 -1
}

# 정렬된 배열의 순서를 지키는 자리에 값을 넣는다 (제자리). 같은 값 뒤에 넣는다
정렬_삽입 = 함수(배열, 값, 비교) {
    i = 상한(배열, 값, 비교)
    배열에 덧붙인다(값)
    j = 길이(배열) - 1
    반복 (j > i) {
        배열[j] = 배열[j - 1]
        j = j - 1
    }
    배열[i] = 값
    반환 배열
}

_탐색_교환 = 함수(배열, i, j) {
    임시 = 배열[i]
    배열[i] = 배열[j]
    배열[j] = 임시
}

_탐색_내리기 = 함수(배열, 시작, 끝, 비교) {
    뿌리 = 시작
    반복 (참) {
        자식 = 뿌리 * 2 + 1
        만약 (자식 >= 끝) {
            중단
        }
        만약 (자식 + 1 < 끝 && 비교(배열[자식], 배열[자식 + 1]) < 0) {
            자식 = 자식 + 1
        }
        만약 (비교(배열[뿌리], 배열[자식]) >= 0) {
            중단
        }
        _탐색_교환(배열, 뿌리, 자식)
        뿌리 = 자식
    }
}

# 배열을 제자리에서 정렬한다 (힙 정렬, O(n log n), 안정 정렬 아님). 정렬한 배열을 돌려준다
힙_정렬 = 함수(배열, 비교) {
    n = 길이(배열)
    i = n / 2 - 1
    반복 (i >= 0) {
        _탐색_내리기(배열, i, n, 비교)
        i = i - 1
    }
    끝 = n - 1
    반복 (끝 > 0) {
        _탐색_교환(배열, 0, 끝)
        _탐색_내리기(배열, 0, 끝, 비교)
        끝 = 끝 - 1
    }
    반환 배열
}

# 배열을 제자리에서 뒤집는다
제자리_뒤집기 = 함수(배열) {
    i = 0
    j = 길이(배열) - 1
    반복 (i < j) {
        _탐색_교환(배열, i, j)
        i = i + 1
        j = j - 1
    }
    반환 배열
}
