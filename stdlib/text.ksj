# text 모듈
# KingSejong 표준 라이브러리 - 문자열 검색과 다듬기 (C 의 string.h)
# 모두 KingSejong 코드로 쓰였다. 위치는 바이트가 아니라 글자 단위이고, 찾지 못하면 -1 이다.

# 찾을것의 KMP 실패 함수: 접두사이면서 접미사인 가장 긴 길이
_텍스트_실패표 = 함수(패턴) {
    m = 길이(패턴)
    표 = [0]
    k = 0
    i = 1
    반복 (i < m) {
        반복 (k > 0 && 패턴[i] != 패턴[k]) {
            k = 표[k - 1]
        }
        만약 (패턴[i] == 패턴[k]) {
            k = k + 1
        }
        표에 덧붙인다(k)
        i = i + 1
    }
    반환 표
}

# 시작 위치부터 찾을것이 처음 나오는 글자 위치 (strstr). KMP 라 O(n + m)
위치_찾기 = 함수(텍스트, 찾을것, 시작) {
    글자들 = 분리(텍스트, "")
    패턴 = 분리(찾을것, "")
    n = 길이(글자들)
    m = 길이(패턴)
    만약 (시작 < 0) {
        시작 = 0
    }
    만약 (m == 0) {
        만약 (시작 <= n) {
            반환 시작
        }
        반환 -1
    }
    표 = _텍스트_실패표(패턴)
    k = 0
    i = 시작
    반복 (i < n) {
        반복 (k > 0 && 글자들[i] != 패턴[k]) {
            k = 표[k - 1]
        }
        만약 (글자들[i] == 패턴[k]) {
            k = k + 1
        }
        만약 (k == m) {
            반환 i - m + 1
        }
        i = i + 1
    }
    반환 -1
}

# 찾을것이 마지막으로 나오는 글자 위치 (strrstr)
마지막_위치_찾기 = 함수(텍스트, 찾을것) {
    위치 = -1
    다음 = 위치_찾기(텍스트, 찾을것, 0)
    반복 (다음 >= 0) {
        위치 = 다음
        다음 = 위치_찾기(텍스트, 찾을것, 다음 + 1)
    }
    반환 위치
}

# 겹치지 않게 센 횟수. 찾을것이 비면 0
개수_세기 = 함수(텍스트, 찾을것) {
    m = 길이(찾을것)
    만약 (m == 0) {
        반환 0
    }
    개수 = 0
    위치 = 위치_찾기(텍스트, 찾을것, 0)
    반복 (위치 >= 0) {
        개수 = 개수 + 1
        위치 = 위치_찾기(텍스트, 찾을것, 위치 + m)
    }
    반환 개수
}

시작하는가 = 함수(텍스트, 앞) {
    m = 길이(앞)
    반환 m <= 길이(텍스트) && (m == 0 || 텍스트[0부터 m미만] == 앞)
}

끝나는가 = 함수(텍스트, 뒤) {
    n = 길이(텍스트)
    m = 길이(뒤)
    반환 m <= n && (m == 0 || 텍스트[n - m부터 n미만] == 뒤)
}

_텍스트_공백인가 = 함수(글자) {
    c = 문자코드(글자)
    반환 c == 32 || (c >= 9 && c <= 13)
}

# 앞뒤 공백(공백, 탭, 줄바꿈 등)을 지운다
다듬기 = 함수(텍스트) {
    글자들 = 분리(텍스트, "")
    시작 = 0
    끝 = 길이(글자들)
    반복 (시작 < 끝 && _텍스트_공백인가(글자들[시작])) {
        시작 = 시작 + 1
    }
    반복 (끝 > 시작 && _텍스트_공백인가(글자들[끝 - 1])) {
        끝 = 끝 - 1
    }
    만약 (시작 == 끝) {
        반환 ""
    }
    반환 텍스트[시작부터 끝미만]
}

# 구분자 글자들 중 아무 글자에서나 나누고 빈 토큰은 버린다 (strtok)
토큰_나누기 = 함수(텍스트, 구분자들) {
    구분 = {}
    분리(구분자들, "") 각각에 대해 g로 {
        구분[g] = 참
    }
    토큰들 = []
    현재 = []
    분리(텍스트, "") 각각에 대해 g로 {
        만약 (딕셔너리_포함(구분, g)) {
            만약 (길이(현재) > 0) {
                토큰들에 덧붙인다(_텍스트_잇기(현재))
                현재 = []
            }
        } 아니면 {
            현재에 덧붙인다(g)
        }
    }
    만약 (길이(현재) > 0) {
        토큰들에 덧붙인다(_텍스트_잇기(현재))
    }
    반환 토큰들
}

# 글자 배열을 문자열로. 둘씩 짝지어 합쳐 O(n log n)
_텍스트_잇기 = 함수(조각들) {
    만약 (길이(조각들) == 0) {
        반환 ""
    }
    현재 = 조각들
    반복 (길이(현재) > 1) {
        합친것 = []
        i = 0
        반복 (i + 1 < 길이(현재)) {
            합친것에 덧붙인다(현재[i] + 현재[i + 1])
            i = i + 2
        }
        만약 (i < 길이(현재)) {
            합친것에 덧붙인다(현재[i])
        }
        현재 = 합친것
    }
    반환 현재[0]
}

# 글자 코드 순서로 비교해 -1, 0, 1 (strcmp)
텍스트_비교 = 함수(a, b) {
    만약 (a < b) {
        반환 -1
    }
    만약 (a > b) {
        반환 1
    }
    반환 0
}

# 찾을것을 모두 바꿀것으로 (겹치지 않게 왼쪽부터). 찾을것이 비면 그대로
모두_바꾸기 = 함수(텍스트, 찾을것, 바꿀것) {
    m = 길이(찾을것)
    만약 (m == 0) {
        반환 텍스트
    }
    조각들 = []
    시작 = 0
    위치 = 위치_찾기(텍스트, 찾을것, 0)
    반복 (위치 >= 0) {
        만약 (위치 > 시작) {
            조각들에 덧붙인다(텍스트[시작부터 위치미만])
        }
        조각들에 덧붙인다(바꿀것)
        시작 = 위치 + m
        위치 = 위치_찾기(텍스트, 찾을것, 시작)
    }
    만약 (시작 < 길이(텍스트)) {
        조각들에 덧붙인다(텍스트[시작부터 길이(텍스트)미만])
    }
    반환 _텍스트_잇기(조각들)
}
