# utils.ksj
# 유틸리티 함수 모듈
# 범용 유틸리티 함수를 제공합니다.
# 범위_단계·채우기(array), 절댓값·최댓값·최솟값·제한(math), 비어있는가(string)는 그 모듈의 함수를 가져와 그대로 내보낸다.
# 같은 이름의 함수를 두 벌 두면 두 모듈을 함께 가져올 수 없다(이름 충돌 오류).

가져오기 "stdlib/array"
가져오기 "stdlib/math"
가져오기 "stdlib/string"

# 타입 검사 함수

# 정수인가(값) - 정수인지 확인
정수인가 = 함수(값) {
    반환 타입(값) == "정수"
}

# 실수인가(값) - 실수인지 확인
실수인가 = 함수(값) {
    반환 타입(값) == "실수"
}

# 문자열인가(값) - 문자열인지 확인
문자열인가 = 함수(값) {
    반환 타입(값) == "문자열"
}

# 배열인가(값) - 배열인지 확인
배열인가 = 함수(값) {
    반환 타입(값) == "배열"
}

# 함수인가(값) - 함수인지 확인
함수인가 = 함수(값) {
    타입명 = 타입(값)
    반환 타입명 == "함수" 또는 타입명 == "내장함수"
}

# 범위 체크 함수

# 범위_안에(값, 최소, 최대) - 값이 범위 안에 있는지 확인
범위_안에 = 함수(값, 최소, 최대) {
    반환 값 >= 최소 그리고 값 <= 최대
}

# 양수인가(값) - 양수인지 확인
양수인가 = 함수(값) {
    반환 값 > 0
}

# 음수인가(값) - 음수인지 확인
음수인가 = 함수(값) {
    반환 값 < 0
}

# 짝수인가(값) - 짝수인지 확인
짝수인가 = 함수(값) {
    반환 값 % 2 == 0
}

# 홀수인가(값) - 홀수인지 확인
홀수인가 = 함수(값) {
    반환 값 % 2 != 0
}

# 변환 함수

# 정수를_문자로(값) - 정수를 문자열로 변환 (음수와 두 자리 이상 포함)
정수를_문자로 = 함수(값) {
    반환 문자열(값)
}

# 참거짓을_문자열로(값) - Boolean을 문자열로 변환
참거짓을_문자열로 = 함수(값) {
    만약 (값) {
        반환 "참"
    } 아니면 {
        반환 "거짓"
    }
}

# 조건 함수

# 선택(조건, 참값, 거짓값) - 조건에 따라 값 선택
선택 = 함수(조건, 참값, 거짓값) {
    만약 (조건) {
        반환 참값
    } 아니면 {
        반환 거짓값
    }
}

# 배열 생성 함수

# 정수_범위(시작, 끝) - 시작부터 끝까지의 정수 배열 생성
정수_범위 = 함수(시작, 끝) {
    결과 = []
    i = 시작
    반복 (i <= 끝) {
        결과 = 결과 + [i]
        i = i + 1
    }
    반환 결과
}

# 문자열 함수

# 문자열_반복(문자열, 횟수) - 문자열을 n번 반복
문자열_반복 = 함수(문자열, 횟수) {
    결과 = ""
    i = 0
    반복 (i < 횟수) {
        결과 = 결과 + 문자열
        i = i + 1
    }
    반환 결과
}

# 수학 유틸리티

# 교환(a, b) - 두 수를 교환
교환 = 함수(a, b) {
    반환 [b, a]
}
