# stdlib/char, stdlib/bytes 검사 (CMakeLists.txt 의 stdlib-char-bytes). 하나라도 틀리면 assert_* 가 실행 오류로 끝낸다
가져오기 "stdlib/char"
가져오기 "stdlib/bytes"

# 오류가 나야 하는 호출이면 참
오류인가 = 함수(f) {
    시도 {
        f()
    } 오류 (e) {
        반환 참
    }
    반환 거짓
}

# --- char: 분류 ---
assert_참(숫자_글자인가("0") && 숫자_글자인가("9") && !숫자_글자인가("a") && !숫자_글자인가("٣"))
assert_참(대문자_글자인가("A") && 대문자_글자인가("Z") && !대문자_글자인가("a") && !대문자_글자인가("["))
assert_참(소문자_글자인가("a") && 소문자_글자인가("z") && !소문자_글자인가("A") && !소문자_글자인가("{"))
assert_참(영문_글자인가("q") && 영숫자_글자인가("7") && !영숫자_글자인가("_"))
assert_참(공백_글자인가(" ") && 공백_글자인가("\t") && 공백_글자인가("\n") && !공백_글자인가("a"))
assert_참(십육진수_글자인가("f") && 십육진수_글자인가("F") && 십육진수_글자인가("0") && !십육진수_글자인가("g") && !십육진수_글자인가("G"))
assert_참(한글_글자인가("가") && 한글_글자인가("힣") && !한글_글자인가("ㄱ") && !한글_글자인가("a"))

# --- char: 변환 ---
assert_같음(대문자로("a"), "A")
assert_같음(대문자로("Z"), "Z")
assert_같음(대문자로("가"), "가")
assert_같음(소문자로("Q"), "q")
assert_같음(자릿값("7"), 7)
assert_같음(자릿값("f"), 15)
assert_같음(자릿값("Z"), 35)
assert_같음(자릿값("!"), -1)
assert_같음(한글_분해("한"), [18, 0, 4])
assert_같음(한글_분해("가"), [0, 0, 0])
assert_같음(한글_분해("a"), 없음)
assert_참(받침있는가("한") && !받침있는가("가") && !받침있는가("a"))

# --- bytes: UTF-8 ---
assert_같음(UTF8_인코딩(""), [])
assert_같음(UTF8_인코딩("A"), [65])
assert_같음(UTF8_인코딩("é"), [0xC3, 0xA9])
assert_같음(UTF8_인코딩("가"), [0xEA, 0xB0, 0x80])
assert_같음(UTF8_인코딩("😀"), [0xF0, 0x9F, 0x98, 0x80])
섞인것 = "Aé가😀 끝"
assert_같음(UTF8_디코딩(UTF8_인코딩(섞인것)), 섞인것)
assert_참(오류인가(함수() { UTF8_디코딩([0xC0, 0x80]) }))  # 과잉 길이 (C0, C1 은 쓰이지 않는다)
assert_참(오류인가(함수() { UTF8_디코딩([0xE0, 0x80, 0x80]) }))  # 과잉 길이
assert_참(오류인가(함수() { UTF8_디코딩([0xEA, 0xB0]) }))  # 중간에 끊김
assert_참(오류인가(함수() { UTF8_디코딩([0x80]) }))  # 이어지는 바이트로 시작
assert_참(오류인가(함수() { UTF8_디코딩([0xEA, 0x41, 0x80]) }))  # 이어지는 바이트가 아님
assert_참(오류인가(함수() { UTF8_디코딩([0xED, 0xA0, 0x80]) }))  # 서로게이트
assert_참(오류인가(함수() { UTF8_디코딩([0xF4, 0x90, 0x80, 0x80]) }))  # U+10FFFF 초과

# --- bytes: 16진수 ---
assert_같음(십육진수_인코딩([]), "")
assert_같음(십육진수_인코딩([0, 15, 16, 255]), "000f10ff")
assert_같음(십육진수_디코딩("000F10ff"), [0, 15, 16, 255])
assert_참(오류인가(함수() { 십육진수_디코딩("abc") }))
assert_참(오류인가(함수() { 십육진수_디코딩("zz") }))

# --- bytes: Base64 (RFC 4648 의 시험 벡터, 내장 Base64_인코딩 과 비교) ---
벡터 = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
기대 = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]
i가 0부터 길이(벡터) 미만 {
    바이트들 = UTF8_인코딩(벡터[i])
    assert_같음(BASE64_인코딩(바이트들), 기대[i])
    assert_같음(BASE64_인코딩(바이트들), Base64_인코딩(벡터[i]))
    assert_같음(BASE64_디코딩(기대[i]), 바이트들)
}
모든바이트 = []
i가 0부터 256 미만 {
    모든바이트에 덧붙인다(i)
}
assert_같음(BASE64_디코딩(BASE64_인코딩(모든바이트)), 모든바이트)
assert_참(오류인가(함수() { BASE64_디코딩("Zm9") }))  # 길이가 4의 배수가 아님
assert_참(오류인가(함수() { BASE64_디코딩("Zm9*") }))  # Base64 가 아닌 글자
assert_참(오류인가(함수() { BASE64_디코딩("Z=9v") }))  # 채움 뒤에 글자

# --- bytes: FNV-1a 64 (공개된 시험 값) ---
assert_같음(FNV1a_64([]), 0xcbf29ce484222325)
assert_같음(FNV1a_64(UTF8_인코딩("a")), 0xaf63dc4c8601ec8c)
assert_같음(FNV1a_64(UTF8_인코딩("foobar")), 0x85944171f73967e8)

# --- 조각_잇기 ---
assert_같음(조각_잇기([]), "")
assert_같음(조각_잇기(["a"]), "a")
assert_같음(조각_잇기(["a", "b", "c", "d", "e"]), "abcde")

출력("char, bytes 검사 통과")
