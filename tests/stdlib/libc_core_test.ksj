# stdlib/convert, stdlib/text, stdlib/search 검사 (CMakeLists.txt 의 stdlib-libc-core). 틀리면 assert_* 가 실행 오류로 끝낸다
가져오기 "stdlib/convert"
가져오기 "stdlib/text"
가져오기 "stdlib/search"

오류인가 = 함수(f) {
    시도 {
        f()
    } 오류 (e) {
        반환 참
    }
    반환 거짓
}

# --- convert: 정수 파싱·형식화 (strtol, itoa) ---
assert_같음(정수_파싱("  -42 ", 10), -42)
assert_같음(정수_파싱("+7", 10), 7)
assert_같음(정수_파싱("0xff", 0), 255)
assert_같음(정수_파싱("FF", 16), 255)
assert_같음(정수_파싱("0x1F", 16), 31)
assert_같음(정수_파싱("-0b101", 0), -5)
assert_같음(정수_파싱("0o17", 0), 15)
assert_같음(정수_파싱("017", 0), 17)
assert_같음(정수_파싱("z", 36), 35)
assert_같음(정수_파싱("-9223372036854775808", 10), -9223372036854775807 - 1)
assert_같음(정수_파싱("9223372036854775807", 10), 9223372036854775807)
assert_참(오류인가(함수() { 정수_파싱("9223372036854775808", 10) }))  # 넘침
assert_참(오류인가(함수() { 정수_파싱("12a", 10) }))
assert_참(오류인가(함수() { 정수_파싱("", 10) }))
assert_참(오류인가(함수() { 정수_파싱("-", 10) }))
assert_참(오류인가(함수() { 정수_파싱("12", 1) }))
assert_참(오류인가(함수() { 정수_파싱("2", 2) }))
assert_같음(정수_형식화(255, 16), "ff")
assert_같음(정수_형식화(-255, 2), "-11111111")
assert_같음(정수_형식화(0, 7), "0")
assert_같음(정수_형식화(-9223372036854775807 - 1, 10), "-9223372036854775808")
assert_같음(정수_형식화(35, 36), "z")
i가 -50부터 50까지 {
    assert_같음(정수_파싱(정수_형식화(i * 7919, 3), 3), i * 7919)
}

# --- convert: 실수 파싱 (strtod). 15자리 이하·작은 지수는 내장 실수() 와 같은 값이다 ---
목록 = ["0", "3.14", "-1e-3", ".5", "2.", "1E10", "0.1", "0.3", "123456.789", "-0.000123", "6.02214076e23", "1e-300"]
목록 각각에 대해 s로 {
    assert_같음(실수_파싱(s), 실수(s))
}
assert_같음(실수_파싱("-inf") < -1e308, 참)
assert_참(오류인가(함수() { 실수_파싱("") }))
assert_참(오류인가(함수() { 실수_파싱(".") }))
assert_참(오류인가(함수() { 실수_파싱("1e") }))
assert_참(오류인가(함수() { 실수_파싱("1.5kg") }))

# --- convert: 실수 형식화와 형식화 (printf). 반올림은 0 에서 먼 쪽 ---
assert_같음(실수_형식화(3.14159, 2), "3.14")
assert_같음(실수_형식화(-2.5, 0), "-3")
assert_같음(실수_형식화(0.125, 2), "0.13")
assert_같음(실수_형식화(0.999, 2), "1.00")
assert_같음(실수_형식화(1e15, 3), "1000000000000000.000")
assert_같음(실수_형식화(5.0, 0), "5")
assert_같음(형식화("[%d] [%5d] [%-5d] [%05d] [%+d] [%x] [%X] [%08b] [%o]", [42, 42, 42, -42, 7, 255, 255, 5, 8]), "[42] [   42] [42   ] [-0042] [+7] [ff] [FF] [00000101] [10]")
assert_같음(형식화("[%.2f] [%8.3f] [%-8.1f] [%f] [%010.2f]", [3.14159, 2.5, 1.5, 1, -3.14159]), "[3.14] [   2.500] [1.5     ] [1.000000] [-000003.14]")
assert_같음(형식화("[%s] [%5s] [%-4s] [%.3s] [%c%c] [100%%]", ["안녕", "abc", "가", "abcdef", 75, "가"]), "[안녕] [  abc] [가   ] [abc] [K가] [100%]")
assert_참(오류인가(함수() { 형식화("%d %d", [1]) }))
assert_참(오류인가(함수() { 형식화("%d", [1, 2]) }))
assert_참(오류인가(함수() { 형식화("%d", ["x"]) }))
assert_참(오류인가(함수() { 형식화("%q", [1]) }))
assert_참(오류인가(함수() { 형식화("끝%", []) }))

# --- text (string.h) ---
assert_같음(위치_찾기("한글 abcabd abd", "abd", 0), 6)
assert_같음(위치_찾기("aaaab", "aab", 0), 2)
assert_같음(위치_찾기("abab", "ab", 1), 2)
assert_같음(위치_찾기("abc", "", 1), 1)
assert_같음(위치_찾기("abc", "x", 0), -1)
assert_같음(위치_찾기("abc", "abcd", 0), -1)
assert_같음(마지막_위치_찾기("abcabc", "bc"), 4)
assert_같음(마지막_위치_찾기("abc", "z"), -1)
assert_같음(개수_세기("aaaa", "aa"), 2)
assert_같음(개수_세기("가나가나가", "가"), 3)
assert_같음(개수_세기("abc", ""), 0)
assert_참(시작하는가("안녕하세요", "안녕") && !시작하는가("안", "안녕") && 시작하는가("x", ""))
assert_참(끝나는가("file.ksj", ".ksj") && !끝나는가("ksj", "file.ksj") && 끝나는가("x", ""))
assert_같음(다듬기("  \t 안녕 하세요 \n"), "안녕 하세요")
assert_같음(다듬기("   "), "")
assert_같음(토큰_나누기("a, b,,c ;d", ", ;"), ["a", "b", "c", "d"])
assert_같음(토큰_나누기(",,", ","), [])
assert_같음(텍스트_비교("a", "b"), -1)
assert_같음(텍스트_비교("b", "a"), 1)
assert_같음(텍스트_비교("가", "가"), 0)
assert_같음(모두_바꾸기("a-b-c", "-", "+"), "a+b+c")
assert_같음(모두_바꾸기("aaa", "aa", "b"), "ba")
assert_같음(모두_바꾸기("한글한글", "글", ""), "한한")
assert_같음(모두_바꾸기("abc", "", "x"), "abc")
# 긴 입력에서 KMP 가 끝까지 찾는다
긴 = "ab" * 5000 + "abc"
assert_같음(위치_찾기(긴, "abc", 0), 10000)

# --- search (bsearch, lower/upper bound, 제자리 정렬) ---
a = [1, 3, 3, 3, 5, 8]
assert_같음(하한(a, 3, 기본_비교), 1)
assert_같음(상한(a, 3, 기본_비교), 4)
assert_같음(이진_탐색(a, 3, 기본_비교), 1)
assert_같음(이진_탐색(a, 4, 기본_비교), -1)
assert_같음(하한(a, 99, 기본_비교), 6)
assert_같음(하한(a, -1, 기본_비교), 0)
assert_같음(이진_탐색([], 1, 기본_비교), -1)
b = [1, 2, 4]
c = b
정렬_삽입(b, 3, 기본_비교)
assert_같음(c, [1, 2, 3, 4])  # 제자리에서 바뀐다
assert_같음(정렬_삽입([], 1, 기본_비교), [1])
섞인것 = []
i가 0부터 200 미만 {
    섞인것에 덧붙인다((i * 37) % 200)
}
힙_정렬(섞인것, 기본_비교)
assert_같음(섞인것, 섞인것을 정렬한다)
assert_같음(섞인것[0], 0)
assert_같음(섞인것[199], 199)
assert_같음(힙_정렬(["다", "가", "나"], 기본_비교), ["가", "나", "다"])
assert_같음(힙_정렬([3, 1, 2], 함수(x, y) { 반환 y - x }), [3, 2, 1])
assert_같음(힙_정렬([], 기본_비교), [])
assert_같음(제자리_뒤집기([1, 2, 3, 4]), [4, 3, 2, 1])
assert_같음(제자리_뒤집기([1]), [1])

출력("convert, text, search 검사 통과")
