# stdlib/bigint, stdlib/random, stdlib/date 와 convert 의 실수_파싱 검사 (CMakeLists.txt 의 stdlib-libc-rest).
# 기대값은 Python 의 int, float(), datetime 과 xoshiro256** 참조 구현으로 만들었다. 틀리면 assert_* 가 실행 오류로 끝낸다
가져오기 "stdlib/bigint"
가져오기 "stdlib/random"
가져오기 "stdlib/date"
가져오기 "stdlib/convert"

오류인가 = 함수(f) {
    시도 {
        f()
    } 오류 (e) {
        반환 참
    }
    반환 거짓
}

# --- bigint: 사칙연산 (몫은 0 쪽으로 버리고 나머지 부호는 나뉘는 수를 따른다) ---
s = 큰정수_문자열
assert_같음(s(큰정수_더하기("0", "5")), "5")
assert_같음(s(큰정수_빼기("0", "5")), "-5")
assert_같음(s(큰정수_곱하기("0", "5")), "0")
assert_같음(s(큰정수_나누기("0", "5")), "0")
assert_같음(s(큰정수_나머지("0", "5")), "0")
assert_같음(큰정수_비교("0", "5"), -1)
assert_같음(s(큰정수_더하기("1000000000", "1")), "1000000001")
assert_같음(s(큰정수_빼기("1000000000", "1")), "999999999")
assert_같음(s(큰정수_곱하기("1000000000", "1")), "1000000000")
assert_같음(s(큰정수_나누기("1000000000", "1")), "1000000000")
assert_같음(s(큰정수_나머지("1000000000", "1")), "0")
assert_같음(큰정수_비교("1000000000", "1"), 1)
assert_같음(s(큰정수_더하기("-1000000000", "7")), "-999999993")
assert_같음(s(큰정수_빼기("-1000000000", "7")), "-1000000007")
assert_같음(s(큰정수_곱하기("-1000000000", "7")), "-7000000000")
assert_같음(s(큰정수_나누기("-1000000000", "7")), "-142857142")
assert_같음(s(큰정수_나머지("-1000000000", "7")), "-6")
assert_같음(큰정수_비교("-1000000000", "7"), -1)
assert_같음(s(큰정수_더하기("1000000000000000000", "999999999")), "1000000000999999999")
assert_같음(s(큰정수_빼기("1000000000000000000", "999999999")), "999999999000000001")
assert_같음(s(큰정수_곱하기("1000000000000000000", "999999999")), "999999999000000000000000000")
assert_같음(s(큰정수_나누기("1000000000000000000", "999999999")), "1000000001")
assert_같음(s(큰정수_나머지("1000000000000000000", "999999999")), "1")
assert_같음(큰정수_비교("1000000000000000000", "999999999"), 1)
assert_같음(s(큰정수_더하기("18446744073709551616", "4294967297")), "18446744078004518913")
assert_같음(s(큰정수_빼기("18446744073709551616", "4294967297")), "18446744069414584319")
assert_같음(s(큰정수_곱하기("18446744073709551616", "4294967297")), "79228162532711081667253501952")
assert_같음(s(큰정수_나누기("18446744073709551616", "4294967297")), "4294967295")
assert_같음(s(큰정수_나머지("18446744073709551616", "4294967297")), "1")
assert_같음(큰정수_비교("18446744073709551616", "4294967297"), 1)
assert_같음(s(큰정수_더하기("-9223372036854775808", "-1")), "-9223372036854775809")
assert_같음(s(큰정수_빼기("-9223372036854775808", "-1")), "-9223372036854775807")
