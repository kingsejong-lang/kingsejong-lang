assert_같음(난수_실수(g), 0.8396274618764198)
g = 난수_생성기(1)
i가 1부터 200까지 {
    x = 난수_범위(g, -3, 3)
    assert_참(x >= -3 && x <= 3)
    f = 난수_실수(g)
    assert_참(f >= 0.0 && f < 1.0)
}
assert_같음(난수_범위(g, 5, 5), 5)
x = 난수_범위(g, -4611686018427387904, 4611686018427387902)  # 개수 2^63 - 1 이 가장 넓다
assert_참(x >= -4611686018427387904 && x <= 4611686018427387902)
assert_참(오류인가(함수() { 난수_범위(g, -9223372036854775807 - 1, 0) }))
assert_참(오류인가(함수() { 난수_범위(g, 0, 9223372036854775807) }))
assert_참(오류인가(함수() { 난수_범위(g, 2, 1) }))
섞인것 = 난수_섞기(난수_생성기(3), [1, 2, 3, 4, 5, 6, 7, 8])
정렬된것 = []
섞인것 각각에 대해 값으로 {
    정렬된것에 덧붙인다(값)
}
assert_같음(정렬된것을 정렬한다, [1, 2, 3, 4, 5, 6, 7, 8])
assert_같음(섞인것, 난수_섞기(난수_생성기(3), [1, 2, 3, 4, 5, 6, 7, 8]))
assert_참(오류인가(함수() { 난수_선택(g, []) }))

