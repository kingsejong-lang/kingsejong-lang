{
  "name": "kingsejong",
  "displayName": "KingSejong Language Support",
  "description": "Language support for KingSejong - Korean-based programming language",
  "version": "0.1.0",
  "publisher": "kingsejong-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingsejong-lang/kingsejong-lang"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kingsejong",
    "korean",
    "한글",
    "프로그래밍"
  ],
  "activationEvents": [
    "onLanguage:kingsejong"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kingsejong",
        "aliases": [
          "KingSejong",
          "킹세종"
        ],
        "extensions": [
          ".ksj",
          ".kingsejong"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kingsejong",
        "scopeName": "source.kingsejong",
        "path": "./syntaxes/kingsejong.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "KingSejong",
      "properties": {
        "kingsejong.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP 서버와의 통신 로그 레벨"
        },
        "kingsejong.formatter.enable": {
          "type": "boolean",
          "default": true,
          "description": "KingSejong 코드 포맷터 활성화"
        },
        "kingsejong.formatter.indentSize": {
          "type": "number",
          "default": 4,
          "description": "들여쓰기 크기 (프로젝트의 .ksjfmt.json 이 있으면 그 값이 우선한다)"
        },
        "kingsejong.formatter.useSpaces": {
          "type": "boolean",
          "default": true,
          "description": "탭 대신 스페이스 사용 (프로젝트의 .ksjfmt.json 이 있으면 그 값이 우선한다)"
        },
        "kingsejong.formatter.maxLineLength": {
          "type": "number",
          "default": 100,
          "description": "최대 줄 길이 (프로젝트의 .ksjfmt.json 이 있으면 그 값이 우선한다)"
        },
        "kingsejong.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "린터 결과를 편집기 진단(경고 밑줄)으로 표시 (규칙별 설정은 프로젝트의 .ksjlint.json 을 따른다)"
        }
      }
    },
    "configurationDefaults": {
      "[kingsejong]": {
        "editor.defaultFormatter": "kingsejong-team.kingsejong"
      }
    },
    "commands": [
      {
        "command": "kingsejong.formatDocument",
        "title": "KingSejong: Format Document"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify --sourcemap",
    "check-types": "tsc -p ./ --noEmit",
    "compile": "tsc -p ./",
    "watch": "npm run bundle -- --watch",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
